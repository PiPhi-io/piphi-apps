{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piphi.io/schemas/piphi-app.schema.json",
  "title": "PiPhi monorepo app metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "source",
    "languages",
    "toolchains",
    "ci",
    "packages"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imported_from"],
      "properties": {
        "imported_from": { "type": ["string", "null"] }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement", "commands", "build_container"],
      "properties": {
        "enforcement": { "enum": ["legacy-static", "full"] },
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "build_container": { "type": "boolean" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "version", "manifest", "artifact", "release"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["integration", "platform_service", "widget"] },
          "version": { "type": "string", "minLength": 1 },
          "manifest": { "type": "string", "minLength": 1 },
          "artifact": {
            "type": "object",
            "additionalProperties": true,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["oci", "widget", "binary"] },
              "context": { "type": "string" },
              "dockerfile": { "type": "string" },
              "output": { "type": "string" },
              "platforms": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "publishing": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "mode": { "enum": ["piphi_managed", "external"] },
              "environment": { "type": "string" },
              "primary": {
                "type": "object",
                "required": ["registry", "repository"],
                "properties": {
                  "registry": { "type": "string" },
                  "repository": { "type": "string" }
                }
              },
              "mirrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["registry", "repository"],
                  "properties": {
                    "registry": { "type": "string" },
                    "repository": { "type": "string" }
                  }
                }
              }
            }
          },
          "release": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag"],
            "properties": {
              "tag": { "const": "apps/{package_id}/v{version}" },
              "commands": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
