{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "piphi-rtl433-bridge",
  "source": {
    "imported_from": "https://github.com/PiPhi-io/piphi-rtl433-bridge"
  },
  "languages": [
    "python"
  ],
  "toolchains": {
    "python": "3.12"
  },
  "ci": {
    "enforcement": "full",
    "commands": [
      "pdm install --check",
      "pdm run pytest --cov=piphi_rtl433_bridge --cov-branch --cov-fail-under=80",
      "pdm run ruff check src tests",
      "pdm run ruff format --check src tests",
      "pdm run mypy src/piphi_rtl433_bridge",
      "pdm run bandit -q -r src",
      "pdm run python scripts/validate.py"
    ],
    "build_container": true
  },
  "packages": [
    {
      "id": "piphi.service.rtl433-bridge",
      "type": "platform_service",
      "version": "0.2.1",
      "manifest": "src/manifest.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "oci",
        "context": ".",
        "dockerfile": "Dockerfile",
        "platforms": [
          "linux/amd64",
          "linux/arm64"
        ]
      },
      "publishing": {
        "mode": "piphi_managed",
        "environment": "release-ghcr-io",
        "primary": {
          "registry": "ghcr.io",
          "repository": "piphi-io/rtl433-bridge"
        },
        "mirrors": []
      }
    }
  ]
}
