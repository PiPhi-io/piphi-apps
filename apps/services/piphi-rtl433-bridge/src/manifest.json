{
  "manifest_version": "1.0",
  "kind": "platform_service",
  "id": "piphi.service.rtl433-bridge",
  "name": "rtl_433 Radio Bridge",
  "description": "Shared rtl_433 radio bridge for receiving sub-GHz sensor packets through PiPhi Core.",
  "version": "0.2.0",
  "image": "ghcr.io/piphi-io/rtl433-bridge:0.2.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/rtl433-bridge:0.2.0",
        "ports": [
          {
            "container": 8091
          }
        ],
        "devices": [
          {
            "host": "/dev/bus/usb",
            "container": "/dev/bus/usb",
            "permissions": "rw"
          }
        ],
        "read_only": true,
        "cap_drop": ["ALL"],
        "security_opt": ["no-new-privileges:true"],
        "environment": {
          "RUNTIME_INGEST_URL": "http://127.0.0.1:8090/ingest/rtl433",
          "HTTP_FORWARD_ENABLED": "true",
          "RADIO_BAND": "433mhz",
          "CUSTOM_FREQUENCY": "",
          "RTLSDR_DEVICE": "auto",
          "RECEIVER_GAIN": "auto",
          "RTL433_PROTOCOLS": "",
          "MQTT_ENABLED": "false",
          "MAX_FORWARD_ATTEMPTS": "4",
          "PACKET_QUEUE_SIZE": "256",
          "DEDUP_WINDOW_SECONDS": "2",
          "MAX_PACKET_BYTES": "65536"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      }
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "title": "Radio Bridge Setup",
      "description": "Choose how PiPhi should listen for sub-GHz sensors. The defaults work for most 433 MHz sensors.",
      "required": [
        "radio_band"
      ],
      "properties": {
        "radio_band": {
          "type": "string",
          "title": "Radio band",
          "description": "Choose the band your sensors use. If you are not sure, start with 433.92 MHz.",
          "default": "433mhz",
          "enum": [
            "315mhz",
            "433mhz",
            "868mhz",
            "915mhz",
            "custom"
          ]
        },
        "custom_frequency": {
          "type": "string",
          "title": "Custom frequency",
          "description": "Only needed when Radio band is Custom. Use rtl_433 format such as 344.975M.",
          "default": "",
          "pattern": "^(?:[2-9][0-9]|[1-9][0-9]{2}|1[0-6][0-9]{2}|17[0-5][0-9]|176[0-6])(?:\\.[0-9]{1,6})?M$"
        },
        "rtlsdr_device": {
          "type": "string",
          "title": "USB receiver",
          "description": "Leave as auto unless you have more than one SDR receiver plugged in.",
          "default": "auto",
          "pattern": "^(?:auto|[0-9]|[12][0-9]|3[01]|serial=[A-Za-z0-9._:-]{1,64})$"
        },
        "receiver_gain": {
          "type": "string",
          "title": "Signal sensitivity",
          "description": "Leave as auto for normal use. Increase only if reception is weak or unreliable.",
          "default": "auto",
          "pattern": "^(?:auto|(?:[0-9]|[1-5][0-9]|60)(?:\\.[0-9]+)?)$"
        },
        "rtl433_protocols": {
          "type": "string",
          "title": "Device type filter",
          "description": "Optional. Leave blank to let rtl_433 identify supported devices automatically. Advanced users may enter comma-separated rtl_433 protocol IDs.",
          "default": "",
          "pattern": "^(?:[1-9][0-9]{0,2})(?:\\s*[,;]\\s*(?:[1-9][0-9]{0,2}))*$|^$"
        },
        "mqtt_enabled": {
          "type": "boolean",
          "title": "Share packets with MQTT",
          "description": "Optional. Enable this only if another app should also receive decoded radio packets.",
          "default": false
        }
      }
    },
    "uiSchema": {
      "ui:options": {
        "translations": {
          "submit": "Start Runtime Service"
        }
      },
      "radio_band": {
        "ui:components": {
          "stringField": "enumField"
        },
        "ui:options": {
          "enumNames": [
            "315 MHz",
            "433.92 MHz - most common",
            "868 MHz",
            "915 MHz",
            "Custom frequency"
          ]
        }
      },
      "custom_frequency": {
        "ui:options": {
          "text": {
            "placeholder": "344.975M"
          },
          "flowbite3Text": {
            "placeholder": "344.975M"
          }
        }
      },
      "rtlsdr_device": {
        "ui:options": {
          "text": {
            "placeholder": "auto"
          },
          "flowbite3Text": {
            "placeholder": "auto"
          }
        }
      },
      "receiver_gain": {
        "ui:options": {
          "text": {
            "placeholder": "auto"
          },
          "flowbite3Text": {
            "placeholder": "auto"
          }
        }
      },
      "rtl433_protocols": {
        "ui:options": {
          "text": {
            "placeholder": "Leave blank for automatic decoding"
          },
          "flowbite3Text": {
            "placeholder": "Leave blank for automatic decoding"
          }
        }
      }
    }
  },
  "provides": {
    "services": [
      {
        "id": "piphi.service.rtl433-bridge",
        "kind": "platform_service",
        "capabilities": [
          "rtl433_packet_ingest",
          "radio_bridge"
        ],
        "shared": true
      }
    ]
  },
  "api": {
    "endpoints": {
      "health": "/health",
      "radio_config": "/radio/config"
    }
  },
  "exports": {
    "env": {
      "RTL433_BRIDGE_ENABLED": "true",
      "RTL433_BRIDGE_RUNTIME_INGEST_URL": "http://127.0.0.1:8090/ingest/rtl433"
    }
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "433 MHz radio bridge (experimental)",
    "summary": "Receive rtl_433 packets through one explicitly mapped RTL-SDR receiver.",
    "category": "networking",
    "device_types": ["platform service", "RTL-SDR receiver"],
    "protocols": ["rtl_433", "sub-GHz receive-only radio"],
    "regions": ["WW"],
    "languages": ["en"],
    "discovery_methods": ["local radio reception"],
    "connectivity": "local",
    "offline_support": "partial",
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "companion_service",
        "label": "Background radio service",
        "reason": "Keeps a bounded receive-only rtl_433 decoder running for the parent integration.",
        "required": true
      },
      {
        "id": "usb_device",
        "label": "Selected receiver access",
        "reason": "Reads RTL-SDR USB nodes without privileged-container or host-network access; select the receiver by serial when several adapters are present.",
        "required": true
      },
      {
        "id": "direct_hardware",
        "label": "Direct radio hardware access",
        "reason": "Receives radio samples from the selected local RTL-SDR adapter.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "RTL-SDR",
        "model": "RTL-SDR-compatible USB receivers with host udev/group permissions",
        "regions": ["WW"]
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-apps/tree/apps/piphi.service.rtl433-bridge/v0.2.0/apps/services/piphi-rtl433-bridge",
    "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-apps/releases/tag/apps/piphi.service.rtl433-bridge/v0.2.0",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "beta",
      "rollout_percent": 10,
      "lifecycle_status": "active",
      "qualification": {"status": "unverified"}
    }
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  }
}
