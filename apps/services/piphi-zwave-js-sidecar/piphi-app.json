{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "piphi-zwave-js-sidecar",
  "source": {
    "imported_from": "https://github.com/PiPhi-io/piphi-zwave-js-sidecar"
  },
  "languages": [
    "node"
  ],
  "toolchains": {
    "node": "22"
  },
  "ci": {
    "enforcement": "full",
    "commands": [
      "npm ci",
      "npm audit --omit=dev --audit-level=high",
      "npm run check",
      "npm run test",
      "npm run validate",
      "npm run build"
    ],
    "build_container": true
  },
  "packages": [
    {
      "id": "piphi-zwave-js-sidecar",
      "type": "platform_service",
      "version": "0.2.0",
      "manifest": "manifest.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "oci",
        "context": ".",
        "dockerfile": "Dockerfile",
        "platforms": [
          "linux/amd64",
          "linux/arm64"
        ]
      },
      "publishing": {
        "mode": "piphi_managed",
        "environment": "release-ghcr-io",
        "primary": {
          "registry": "ghcr.io",
          "repository": "piphi-io/piphi-zwave-js-sidecar"
        },
        "mirrors": []
      }
    }
  ]
}
