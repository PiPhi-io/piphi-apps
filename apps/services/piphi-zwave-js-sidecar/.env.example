PORT=4211
LOG_LEVEL=info
NODE_ENV=development
# Required in production and shared only with the parent integration.
PIPHI_ZWAVE_SIDECAR_TOKEN=replace-with-a-long-random-token
PIPHI_ZWAVE_CACHE_DIR=/var/lib/piphi/zwave-js/cache
PIPHI_ZWAVE_LOCK_DIR=/var/lib/piphi/zwave-js/locks
# Security keys are optional and must be exactly 32 hexadecimal characters.
# PIPHI_ZWAVE_S2_ACCESS_CONTROL_KEY=
# PIPHI_ZWAVE_S2_AUTHENTICATED_KEY=
# PIPHI_ZWAVE_S2_UNAUTHENTICATED_KEY=
# PIPHI_ZWAVE_S0_LEGACY_KEY=
# PIPHI_ZWAVE_LR_S2_ACCESS_CONTROL_KEY=
# PIPHI_ZWAVE_LR_S2_AUTHENTICATED_KEY=
