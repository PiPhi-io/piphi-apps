{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-zwave-js-sidecar",
  "name": "Z-Wave JS sidecar",
  "version": "0.3.0",
  "description": "Own the Z-Wave controller and deliver schema-versioned node events to PiPhi.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sidecar-worker",
    "domain": "sidecar-service",
    "preset_summary": "Sidecar starter with service health and queue-oriented command hooks."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-zwave-js-sidecar:0.3.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-zwave-js-sidecar:0.3.0",
        "ports": [
          {
            "container": 4211
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_ZWAVE_CACHE_DIR": "/var/lib/piphi/zwave-js/cache",
          "PIPHI_ZWAVE_LOCK_DIR": "/var/lib/piphi/zwave-js/locks"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        },
        "volumes": [
          {
            "host": "/var/lib/piphi/zwave-js",
            "container": "/var/lib/piphi/zwave-js",
            "mode": "rw"
          }
        ],
        "devices": [
          {
            "host": "/dev/serial",
            "container": "/dev/serial",
            "permissions": "rwm"
          }
        ]
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command",
      "zwave_events": "/v1/zwave/events",
      "zwave_snapshot": "/v1/zwave/snapshot"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "controller_path",
      "alias",
      "event_queue_capacity"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "controller_path"
    ]
  },
  "identity": {
    "fields": [
      "controller_path"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "driver_ready": {
      "kind": "sensor",
      "unit": "bool"
    },
    "controller_ready": {
      "kind": "sensor",
      "unit": "bool"
    },
    "node_count": {
      "kind": "sensor",
      "unit": "nodes"
    },
    "ready_node_count": {
      "kind": "sensor",
      "unit": "nodes"
    },
    "sleeping_node_count": {
      "kind": "sensor",
      "unit": "nodes"
    },
    "dead_node_count": {
      "kind": "sensor",
      "unit": "nodes"
    },
    "event_queue_depth": {
      "kind": "sensor",
      "unit": "events"
    },
    "dropped_event_count": {
      "kind": "sensor",
      "unit": "events"
    },
    "command_queue_depth": {
      "kind": "sensor",
      "unit": "commands"
    },
    "refresh_controller_information": {
      "kind": "action"
    },
    "reconnect_driver": {
      "kind": "action"
    },
    "ping_node": {
      "kind": "action"
    },
    "request_node_interview": {
      "kind": "action"
    },
    "refresh_node_values": {
      "kind": "action"
    },
    "set_value": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh_controller_information": {
      "description": "Read the current controller and queue state.",
      "timeout_ms": 10000
    },
    "reconnect_driver": {
      "description": "Restart the managed Z-Wave JS driver.",
      "timeout_ms": 30000
    },
    "ping_node": {
      "description": "Ask Z-Wave JS to test whether a node is reachable.",
      "timeout_ms": 30000
    },
    "request_node_interview": {
      "description": "Request a new Z-Wave JS interview for one node.",
      "timeout_ms": 120000
    },
    "refresh_node_values": {
      "description": "Refresh the known values for one node.",
      "timeout_ms": 120000
    },
    "set_value": {
      "description": "Set one metadata-declared writable Z-Wave value.",
      "timeout_ms": 30000
    }
  },
  "entities": [
    {
      "id": "zwave-js-service",
      "name": "Z-Wave JS Service",
      "device_id": "zwave-js-service",
      "entity_type": "service",
      "capabilities": [
        "connected",
        "driver_ready",
        "controller_ready",
        "node_count",
        "ready_node_count",
        "sleeping_node_count",
        "dead_node_count",
        "event_queue_depth",
        "dropped_event_count",
        "command_queue_depth",
        "refresh_controller_information",
        "reconnect_driver",
        "ping_node",
        "request_node_interview",
        "refresh_node_values",
        "set_value"
      ],
      "available_commands": [
        {
          "id": "refresh_controller_information",
          "label": "Refresh controller",
          "kind": "action"
        },
        {
          "id": "reconnect_driver",
          "label": "Reconnect driver",
          "kind": "action"
        },
        {
          "id": "ping_node",
          "label": "Ping node",
          "kind": "action"
        },
        {
          "id": "request_node_interview",
          "label": "Interview node",
          "kind": "action"
        },
        {
          "id": "refresh_node_values",
          "label": "Refresh node values",
          "kind": "action"
        },
        {
          "id": "set_value",
          "label": "Set writable value",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Z-Wave JS sidecar",
    "summary": "Own the Z-Wave controller and deliver schema-versioned node events to PiPhi.",
    "category": "other",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-zwave-js-sidecar/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "device_access",
        "label": "Z-Wave controller device access",
        "reason": "Uses only the configured stable serial controller path and persistent Z-Wave JS cache.",
        "required": true
      },
      {
        "id": "sidecar_runtime",
        "label": "Managed sidecar runtime",
        "reason": "Runs as an isolated helper service consumed by a parent PiPhi integration.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Z-Wave Alliance",
        "model": "Controllers and devices supported by Z-Wave JS"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-zwave-js-sidecar",
    "support_url": "https://github.com/PiPhi-io/piphi-zwave-js-sidecar/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-zwave-js-sidecar/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "Z-Wave controller service"
    ],
    "protocols": [
      "Z-Wave",
      "Z-Wave JS"
    ],
    "discovery_methods": [
      "controller startup",
      "Z-Wave inclusion"
    ],
    "connectivity": "local",
    "offline_support": "full"
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  }
}
