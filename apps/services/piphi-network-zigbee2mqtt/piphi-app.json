{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "piphi-network-zigbee2mqtt",
  "source": {
    "imported_from": "https://github.com/PiPhi-io/piphi_network_zigbee2mqtt"
  },
  "languages": [
    "python"
  ],
  "toolchains": {
    "python": "3.12"
  },
  "ci": {
    "enforcement": "full",
    "commands": [
      "pdm install --check",
      "pdm export --prod --without-hashes --output /tmp/piphi-zigbee2mqtt-requirements.txt && pdm run pip-audit -r /tmp/piphi-zigbee2mqtt-requirements.txt",
      "pdm run ruff check .",
      "pdm run python scripts/validate.py",
      "pdm run pytest"
    ],
    "build_container": true
  },
  "packages": [
    {
      "id": "piphi.service.zigbee2mqtt-sidecar",
      "type": "platform_service",
      "version": "0.1.18",
      "manifest": "src/manifest.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "oci",
        "context": ".",
        "dockerfile": "Dockerfile",
        "platforms": [
          "linux/amd64",
          "linux/arm64"
        ]
      },
      "publishing": {
        "mode": "piphi_managed",
        "environment": "release-ghcr-io",
        "primary": {
          "registry": "ghcr.io",
          "repository": "piphi-io/zigbee2mqtt-sidecar"
        },
        "mirrors": []
      }
    }
  ]
}
