{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-ble-gateway-sidecar",
  "name": "BLE gateway sidecar",
  "version": "0.4.0",
  "description": "Provide bounded, privacy-preserving BLE observations through Bleak on Linux BlueZ and Windows WinRT.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sidecar-worker",
    "domain": "sidecar-service",
    "preset_summary": "Sidecar starter with service health and queue-oriented command hooks."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-ble-gateway-sidecar:0.4.0",
  "platforms": [
    "linux",
    "windows"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-ble-gateway-sidecar:0.4.0",
        "ports": [
          {
            "container": 4210
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_ENV": "production",
          "PIPHI_BLE_HANDLE_KEY_PATH": "/var/lib/piphi/ble-gateway/ble-handle.key",
          "PIPHI_BLE_CHECKPOINT_PATH": "/var/lib/piphi/ble-gateway/ble-latest.json",
          "PIPHI_AUTOMATION_LEDGER_PATH": "/var/lib/piphi/ble-gateway/automation-actions.sqlite3"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        },
        "read_only": true,
        "volumes": [
          {
            "host": "/var/lib/piphi/ble-gateway",
            "container": "/var/lib/piphi/ble-gateway",
            "mode": "rw"
          },
          {
            "host": "/run/dbus/system_bus_socket",
            "container": "/run/dbus/system_bus_socket",
            "mode": "ro"
          },
          {
            "host": "/sys/class/rfkill",
            "container": "/sys/class/rfkill",
            "mode": "ro"
          }
        ]
      },
      "discovery": {
        "method": "passive"
      }
    },
    "windows": {
      "type": "proxy",
      "proxy": {
        "port": 4210,
        "process": {
          "kind": "python_executable",
          "command": "piphi_ble_gateway_sidecar",
          "supervisor": "chief"
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command",
      "ble_consumers": "/v1/ble/consumers/{consumer_id}",
      "ble_observations": "/v1/ble/observations/{consumer_id}",
      "ble_snapshot": "/v1/ble/snapshot/{consumer_id}"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "alias",
      "service_name"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "id"
    ]
  },
  "identity": {
    "fields": [
      "id"
    ]
  },
  "capabilities": {
    "service_available": {
      "kind": "sensor",
      "unit": "bool"
    },
    "receiver_healthy": {
      "kind": "sensor",
      "unit": "bool"
    },
    "scanner_state": {
      "kind": "sensor",
      "unit": "string"
    },
    "scan_mode": {
      "kind": "sensor",
      "unit": "string"
    },
    "observations_received_total": {
      "kind": "sensor",
      "unit": "count"
    },
    "observations_deduplicated_total": {
      "kind": "sensor",
      "unit": "count"
    },
    "last_observation_age_ms": {
      "kind": "sensor",
      "unit": "ms"
    },
    "reconnects": {
      "kind": "sensor",
      "unit": "count"
    },
    "queue_depth": {
      "kind": "sensor",
      "unit": "count"
    },
    "queue_capacity": {
      "kind": "sensor",
      "unit": "count"
    },
    "queue_high_water": {
      "kind": "sensor",
      "unit": "count"
    },
    "drops": {
      "kind": "sensor",
      "unit": "count"
    },
    "coalesces": {
      "kind": "sensor",
      "unit": "count"
    },
    "adapter_count": {
      "kind": "sensor",
      "unit": "count"
    },
    "adapter_powered": {
      "kind": "sensor",
      "unit": "bool"
    },
    "adapter_discovering": {
      "kind": "sensor",
      "unit": "bool"
    },
    "rfkill_soft_blocked": {
      "kind": "sensor",
      "unit": "bool"
    },
    "rfkill_hard_blocked": {
      "kind": "sensor",
      "unit": "bool"
    },
    "refresh": {
      "kind": "action"
    },
    "decrypt_failures": {
      "kind": "sensor",
      "unit": "count"
    },
    "scanner_callback_drops": {
      "kind": "sensor",
      "unit": "count"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 5000
    }
  },
  "entities": [
    {
      "id": "ble-gateway-service",
      "name": "BLE Gateway Service",
      "device_id": "ble-gateway-service",
      "entity_type": "service",
      "capabilities": [
        "service_available",
        "receiver_healthy",
        "scanner_state",
        "scan_mode",
        "observations_received_total",
        "observations_deduplicated_total",
        "last_observation_age_ms",
        "reconnects",
        "queue_depth",
        "queue_capacity",
        "queue_high_water",
        "drops",
        "coalesces",
        "decrypt_failures",
        "scanner_callback_drops",
        "adapter_count",
        "adapter_powered",
        "adapter_discovering",
        "rfkill_soft_blocked",
        "rfkill_hard_blocked",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "BLE gateway sidecar",
    "summary": "Cross-platform Bleak gateway for bounded, private BLE observations.",
    "category": "sensors",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "device_access",
        "label": "Bluetooth adapter access",
        "reason": "Uses a local Bluetooth radio through Bleak (BlueZ on Linux or WinRT on Windows).",
        "required": true
      },
      {
        "id": "sidecar_runtime",
        "label": "Managed sidecar runtime",
        "reason": "Runs as an isolated helper service consumed by a parent PiPhi integration.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Bluetooth SIG",
        "model": "BLE advertisers supported by parent integrations"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-apps/tree/apps/piphi-ble-gateway-sidecar/v0.4.0/apps/services/piphi-ble-gateway-sidecar",
    "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-apps/releases/tag/apps/piphi-ble-gateway-sidecar/v0.4.0",
    "quality_tier": "bronze",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "BLE gateway service"
    ],
    "protocols": [
      "Bluetooth Low Energy"
    ],
    "discovery_methods": [
      "BLE advertisements"
    ],
    "connectivity": "local",
    "offline_support": "full"
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  },
  "deployment_mode": "sidecar",
  "runtime_requirements": [
    "sidecar_runtime",
    "system_dbus_access",
    "bluetooth_adapter_access",
    "persistent_storage"
  ]
}
