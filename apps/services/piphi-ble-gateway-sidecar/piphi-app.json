{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "piphi-ble-gateway-sidecar",
  "source": {
    "imported_from": "https://github.com/PiPhi-io/piphi-ble-gateway-sidecar"
  },
  "languages": [
    "python"
  ],
  "toolchains": {
    "python": "3.12"
  },
  "ci": {
    "enforcement": "full",
    "commands": [
      "pdm install --check",
      "pdm export --prod --output /tmp/piphi-ble-gateway-sidecar-requirements.txt && pdm run pip-audit --disable-pip -r /tmp/piphi-ble-gateway-sidecar-requirements.txt",
      "pdm run pytest",
      "pdm run python scripts/validate.py"
    ],
    "build_container": true,
    "windows_python": true,
    "windows_commands": [
      "pdm install --check",
      "pdm run pytest",
      "python -c \"import shutil; shutil.rmtree('windows-dist', ignore_errors=True)\"",
      "pdm build --no-sdist --dest windows-dist"
    ]
  },
  "packages": [
    {
      "id": "piphi-ble-gateway-sidecar",
      "type": "platform_service",
      "version": "0.3.0",
      "manifest": "manifest.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "oci",
        "context": ".",
        "dockerfile": "Dockerfile",
        "platforms": [
          "linux/amd64",
          "linux/arm64"
        ],
        "python_wheel": true
      },
      "publishing": {
        "mode": "piphi_managed",
        "environment": "release-ghcr-io",
        "primary": {
          "registry": "ghcr.io",
          "repository": "piphi-io/piphi-ble-gateway-sidecar"
        },
        "mirrors": []
      }
    }
  ]
}
