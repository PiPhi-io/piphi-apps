{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-android-adb-sidecar",
  "name": "Android ADB sidecar",
  "version": "0.3.0-rc.1",
  "description": "Provide bounded, authenticated network ADB transport for parent integrations.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sidecar-worker",
    "domain": "sidecar-service",
    "preset_summary": "Sidecar starter with service health and queue-oriented command hooks."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-android-adb-sidecar:0.3.0-rc.1",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-android-adb-sidecar:0.3.0-rc.1",
        "ports": [
          {
            "container": 4213
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_ADB_HOME": "/app/data"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        },
        "volumes": [
          {
            "host": "/var/lib/piphi/android-adb-sidecar",
            "container": "/app/data",
            "mode": "rw"
          }
        ]
      },
      "discovery": {
        "method": "manual"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command",
      "adb_snapshot": "/v1/adb/snapshot",
      "adb_reconnect": "/v1/adb/reconnect",
      "adb_execute": "/v1/adb/execute"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "port",
      "alias",
      "service_name",
      "queue_capacity",
      "connect_timeout_ms",
      "operation_timeout_ms"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host",
      "port"
    ]
  },
  "identity": {
    "fields": [
      "host",
      "port"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "authorized": {
      "kind": "sensor",
      "unit": "bool"
    },
    "lifecycle": {
      "kind": "sensor",
      "unit": "string"
    },
    "service_available": {
      "kind": "sensor",
      "unit": "bool"
    },
    "device_manufacturer": {
      "kind": "sensor",
      "unit": "string"
    },
    "device_model": {
      "kind": "sensor",
      "unit": "string"
    },
    "android_release": {
      "kind": "sensor",
      "unit": "string"
    },
    "android_sdk": {
      "kind": "sensor",
      "unit": "string"
    },
    "queue_depth": {
      "kind": "sensor",
      "unit": "count"
    },
    "queue_capacity": {
      "kind": "sensor",
      "unit": "count"
    },
    "queue_high_water_mark": {
      "kind": "sensor",
      "unit": "count"
    },
    "reconnect_count": {
      "kind": "sensor",
      "unit": "count"
    },
    "request_success_count": {
      "kind": "sensor",
      "unit": "count"
    },
    "request_failure_count": {
      "kind": "sensor",
      "unit": "count"
    },
    "timeout_count": {
      "kind": "sensor",
      "unit": "count"
    },
    "transport_error_count": {
      "kind": "sensor",
      "unit": "count"
    },
    "operation_duration_ms": {
      "kind": "sensor",
      "unit": "ms"
    }
  },
  "commands": {},
  "entities": [
    {
      "id": "android-adb-service",
      "name": "Android ADB Service",
      "device_id": "android-adb-service",
      "entity_type": "service",
      "capabilities": [
        "connected",
        "authorized",
        "lifecycle",
        "service_available",
        "device_manufacturer",
        "device_model",
        "android_release",
        "android_sdk",
        "queue_depth",
        "queue_capacity",
        "queue_high_water_mark",
        "reconnect_count",
        "request_success_count",
        "request_failure_count",
        "timeout_count",
        "transport_error_count",
        "operation_duration_ms"
      ],
      "available_commands": [],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Android ADB sidecar",
    "summary": "Bounded network ADB transport for explicitly configured and authorized Android targets.",
    "category": "networking",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-android-adb-sidecar/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Connects only to the explicitly configured Android ADB endpoint on the local network.",
        "required": true
      },
      {
        "id": "sidecar_runtime",
        "label": "Managed sidecar runtime",
        "reason": "Runs as an isolated helper service consumed by a parent PiPhi integration.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Android",
        "model": "Manually configured devices with authorized ADB-over-network access"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-android-adb-sidecar",
    "support_url": "https://github.com/PiPhi-io/piphi-android-adb-sidecar/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-android-adb-sidecar/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "Android platform service"
    ],
    "protocols": [
      "Android Debug Bridge over TCP"
    ],
    "discovery_methods": [
      "manual configuration only"
    ],
    "connectivity": "local",
    "offline_support": "partial"
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  }
}
