{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-android-adb-sidecar",
  "name": "Android ADB sidecar",
  "version": "0.2.0-rc.1",
  "description": "Draft ADB sidecar scaffold; no device transport is implemented.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sidecar-worker",
    "domain": "sidecar-service",
    "preset_summary": "Sidecar starter with service health and queue-oriented command hooks."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-android-adb-sidecar:0.2.0-rc.1",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-android-adb-sidecar:0.2.0-rc.1",
        "ports": [
          {
            "container": 4213
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "manual"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "service_name"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host"
    ]
  },
  "identity": {
    "fields": [
      "host"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    }
  },
  "commands": {},
  "entities": [
    {
      "id": "android-adb-service",
      "name": "Android ADB Service",
      "device_id": "android-adb-service",
      "entity_type": "service",
      "capabilities": [
        "connected"
      ],
      "available_commands": [],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Android ADB sidecar",
    "summary": "Draft scaffold for a future managed ADB transport; no device I/O is implemented.",
    "category": "networking",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-android-adb-sidecar/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "sidecar_runtime",
        "label": "Managed sidecar runtime",
        "reason": "Runs as an isolated helper service consumed by a parent PiPhi integration.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Android (planned)",
        "model": "No devices supported by this draft scaffold"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-android-adb-sidecar",
    "support_url": "https://github.com/PiPhi-io/piphi-android-adb-sidecar/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-android-adb-sidecar/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "Android platform service"
    ],
    "protocols": [
      "ADB (planned)"
    ],
    "discovery_methods": [
      "manual configuration only"
    ],
    "connectivity": "local",
    "offline_support": "none"
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  }
}
