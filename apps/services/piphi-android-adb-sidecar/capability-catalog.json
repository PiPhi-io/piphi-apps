  "sources": {
    "android_adb": "https://developer.android.com/tools/adb",
    "adb_protocol": "https://android.googlesource.com/platform/packages/modules/adb/+/refs/heads/main/SERVICES.TXT",
    "adb_source": "https://android.googlesource.com/platform/packages/modules/adb/",
    "core_vocabulary": "PiPhi Network Core and maintained PiPhi integrations",
    "parent_contract": "PiPhi Android parent-to-sidecar transport contract v1"
  },
  "groups": [
    {
      "id": "runtime-foundation",
      "status": "implemented",
      "scope": ["sidecar-service"],
      "source_refs": ["core_vocabulary"],
      "reason": "The service reports lifecycle and Platform Tools availability without exposing process, key, endpoint, or credential details.",
      "state": ["service_available", "lifecycle"],
      "events": ["runtime.config.applied", "runtime.config.removed"],
      "conditions": [],
      "actions": []
    },
    {
      "id": "parent-contract-envelope",
      "status": "implemented",
      "scope": ["parent-to-sidecar-messages"],
      "source_refs": ["parent_contract", "core_vocabulary"],
      "reason": "Version 1 validates one opaque target lease, strict payload and timeout bounds, duplicate and extra field rejection, synchronous completion, and a closed public error enum.",
      "state": [],
      "events": [],
      "conditions": [],
      "actions": []
    },
    {
      "id": "network-device-transport",
      "status": "implemented",
      "scope": ["one-manually-configured-network-target"],
      "source_refs": ["android_adb", "adb_protocol", "adb_source"],
      "reason": "The sidecar owns a private Android Platform Tools server, explicitly connects one configured endpoint, verifies authorization and stable internal identity, and issues a non-reversible target lease.",
      "state": ["connected", "authorized", "device_manufacturer", "device_model", "android_release", "android_sdk"],
      "events": [],
      "conditions": [],
      "actions": []
    },
    {
      "id": "bounded-parent-operations",
      "status": "implemented",
      "scope": ["single-explicit-target", "private-parent-api"],
      "source_refs": ["android_adb", "adb_protocol", "parent_contract"],
      "reason": "The private API supports only allow-listed short key events and allow-listed getprop reads. It accepts no shell text, argv, serial, host, path, package, intent, forwarding, or all-device selector. These are private transport operations, not generic PiPhi automation actions.",
      "private_operations": ["key_event", "property_query"],
      "state": ["queue_depth", "queue_capacity", "queue_high_water_mark", "request_success_count", "request_failure_count", "timeout_count", "transport_error_count", "operation_duration_ms"],
      "events": [],
      "conditions": [],
      "actions": []
    },
    {
      "id": "bounded-recovery",
      "status": "implemented",
      "scope": ["configured-network-target"],
      "source_refs": ["android_adb", "parent_contract", "core_vocabulary"],
      "reason": "Read-only property requests may reconnect and retry; key events are never replayed after an uncertain failure. Recovery attempts, queues, output, and deadlines are bounded.",
      "state": ["reconnect_count"],
      "events": [],
      "conditions": [],
      "actions": []
    },
    {
      "id": "wireless-pairing-and-mdns",
      "status": "planned",
      "scope": ["android-11-plus-wireless-debugging", "android-tv-13-plus"],
      "source_refs": ["android_adb", "adb_source"],
      "reason": "mDNS discovery, TLS pairing-code exchange, expiry, revocation, and trusted-network policy require a separate user-interaction and credential lifecycle.",
      "state": ["mdns_available", "pairing_state", "pairing_expires_at"],
      "events": ["pairing.requested", "pairing.completed", "pairing.failed", "pairing.expired"],
      "conditions": ["pairing_is_pending", "pairing_has_expired"],
      "actions": ["pair_with_one_time_code", "cancel_pairing", "forget_paired_endpoint"]
    },
    {
      "id": "usb-transport",
      "status": "planned",
      "scope": ["explicitly-mounted-usb-devices"],
      "source_refs": ["android_adb", "adb_source"],
      "reason": "USB passthrough needs host-device governance, udev and permission qualification, stable by-id selection, and physical fixtures.",
      "state": ["usb_transport_available", "usb_speed"],
      "events": ["usb.device_added", "usb.device_removed"],
      "conditions": ["usb_transport_is_available"],
      "actions": []
    },
    {
      "id": "extended-device-operations",
      "status": "planned",
      "scope": ["parent-owned-device-semantics"],
      "source_refs": ["android_adb", "parent_contract"],
      "reason": "App lifecycle, active activity, screenshots, logs, and package inventory need separate privacy, output-brokering, and per-parent allow-list design.",
      "state": ["active_package", "active_activity", "screen_power_state", "display_resolution", "package_count"],
      "events": ["active_app.changed", "screen.power.changed"],
      "conditions": ["screen_is_awake", "active_package_is"],
      "actions": ["launch_allowlisted_activity", "stop_allowlisted_package", "capture_brokered_screenshot", "read_bounded_log_events", "list_installed_packages"]
    },
    {
      "id": "unsafe-sensitive-and-integration-owned",
      "status": "excluded",
      "scope": ["all-transports-and-consumers"],
      "source_refs": ["android_adb", "adb_protocol", "parent_contract"],
      "reason": "Arbitrary shells, files, packages, forwarding, privilege escalation, raw credentials, broad fanout, and device semantics are outside the safe sidecar contract.",
      "state": ["adb_private_key", "adb_public_key_material", "pairing_code", "raw_device_serial", "raw_shell_output", "raw_logcat", "raw_screenshot_bytes"],
      "events": [],
      "conditions": [],
      "actions": ["execute_arbitrary_shell", "install_arbitrary_apk", "uninstall_arbitrary_package", "push_arbitrary_file", "pull_arbitrary_file", "open_arbitrary_port_forward", "open_reverse_tunnel", "run_as_root", "remount_system", "reboot_bootloader", "reboot_recovery", "factory_reset", "grant_arbitrary_permission", "broadcast_arbitrary_intent", "execute_all_devices", "expose_adb_keys"]
    }
  ]
}
