{
  "id": "demo-device",
  "host": "modbus-rtu-sidecar",
  "alias": "Demo Device",
  "serial_port": "/dev/serial/by-id/usb-example",
  "baud_rate": 9600,
  "parity": "N",
  "stop_bits": 1,
  "registers": [
    {
      "id": "temperature",
      "name": "Temperature",
      "unit_id": 1,
      "address": 10,
      "data_type": "int16",
      "unit": "°C",
      "scale": 0.1,
      "writable": false
    }
  ]
}
