{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-modbus-rtu-sidecar",
  "name": "Modbus RTU sidecar",
  "version": "0.8.1",
  "description": "Coordinate bounded Modbus RTU and ASCII requests over serial buses.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sidecar-worker",
    "domain": "sidecar-service",
    "preset_summary": "Managed serial transport helper with bounded queues and operational health."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-modbus-rtu-sidecar:0.8.1",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-modbus-rtu-sidecar:0.8.1",
        "ports": [
          {
            "container": 4212
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_ENV": "production",
          "PIPHI_AUTOMATION_LEDGER_PATH": "/var/lib/piphi/modbus-rtu-sidecar/automation-actions.sqlite3"
        },
        "devices": [],
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        },
        "read_only": true,
        "tmpfs": [
          "/tmp"
        ],
        "cap_drop": [
          "ALL"
        ],
        "security_opt": [
          "no-new-privileges:true"
        ],
        "volumes": [
          {
            "host": "/var/lib/piphi/modbus-rtu-sidecar",
            "container": "/var/lib/piphi/modbus-rtu-sidecar",
            "mode": "rw"
          }
        ]
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command",
      "modbus_snapshot": "/v1/modbus/snapshot",
      "modbus_events": "/v1/modbus/events",
      "modbus_refresh": "/v1/modbus/refresh",
      "modbus_write": "/v1/modbus/write",
      "modbus_write_coils": "/v1/modbus/write-coils"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "serial_port",
      "serial_mode",
      "baud_rate",
      "parity",
      "stop_bits",
      "data_bits",
      "response_timeout_seconds",
      "queue_capacity",
      "event_capacity",
      "profile_id",
      "profile_version",
      "profile_provenance",
      "profile_sha256",
      "profile_signature",
      "writes_enabled",
      "registers"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "serial_port"
    ],
    "secret_fields": [
      "profile_signature"
    ]
  },
  "identity": {
    "fields": [
      "serial_port"
    ]
  },
  "capabilities": {},
  "commands": {},
  "entities": [],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Modbus RTU sidecar",
    "summary": "Coordinate bounded Modbus RTU and ASCII requests over serial buses.",
    "category": "networking",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-modbus-rtu-sidecar/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "device_access",
        "label": "Serial device access",
        "reason": "Uses a configured stable path from the restricted host /dev/serial/by-id device mount.",
        "required": true
      },
      {
        "id": "sidecar_runtime",
        "label": "Managed sidecar runtime",
        "reason": "Runs as an isolated helper service consumed by a parent PiPhi integration.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Multi-vendor",
        "model": "Modbus RTU and ASCII devices described by parent profiles"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-modbus-rtu-sidecar",
    "support_url": "https://github.com/PiPhi-io/piphi-modbus-rtu-sidecar/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-modbus-rtu-sidecar/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "Serial protocol gateway"
    ],
    "protocols": [
      "Modbus RTU",
      "Modbus ASCII",
      "Serial"
    ],
    "discovery_methods": [
      "manual stable serial adapter selection"
    ],
    "connectivity": "local",
    "offline_support": "partial"
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  },
  "deployment_mode": "sidecar",
  "runtime_requirements": [
    "sidecar_runtime",
    "serial_device_access",
    "secrets_or_api_tokens",
    "persistent_storage"
  ]
}
