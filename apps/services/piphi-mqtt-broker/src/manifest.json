{
  "manifest_version": "1.0",
  "kind": "platform_service",
  "id": "piphi.service.mqtt-broker",
  "name": "MQTT Broker",
  "description": "Shared MQTT broker for PiPhi integrations and helpers.",
  "version": "0.4.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "health": {
        "type": "container"
      },
      "container": {
        "image": "ghcr.io/piphi-io/mqtt-broker:0.4.0",
        "environment": {
          "MQTT_ALLOW_PLAINTEXT": "false",
          "MQTT_TLS_ENABLED": "true",
          "MQTT_TLS_REQUIRE_CLIENT_CERTIFICATE": "true"
        },
        "ports": [
          {
            "container": 1883
          }
        ],
        "volumes": [
          {
            "host": "/var/lib/piphi/mqtt/config",
            "container": "/mosquitto/config"
          },
          {
            "host": "/var/lib/piphi/mqtt/data",
            "container": "/mosquitto/data"
          },
          {
            "host": "/var/lib/piphi/mqtt/log",
            "container": "/mosquitto/log"
          },
          {
            "host": "/var/lib/piphi/mqtt/secrets",
            "container": "/run/secrets",
            "read_only": true
          }
        ],
        "restart_policy": {
          "name": "unless-stopped"
        }
      }
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "required": [
        "listener_port",
        "auth_policy_file",
        "tls_ca_file",
        "tls_cert_file",
        "tls_key_file",
        "health_tls_cert_file",
        "health_tls_key_file"
      ],
      "properties": {
        "listener_port": {
          "type": "integer",
          "title": "MQTT Port",
          "x-env": "MQTT_PORT",
          "default": 1883,
          "minimum": 1,
          "maximum": 65535
        },
        "allow_plaintext": {
          "type": "boolean",
          "title": "Allow Plaintext on the Private Service Network",
          "description": "Enable only when network isolation is enforced by PiPhi Core.",
          "x-env": "MQTT_ALLOW_PLAINTEXT",
          "default": false
        },
        "username": {
          "type": "string",
          "title": "Broker Username",
          "x-env": "MQTT_USERNAME",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "password": {
          "type": "string",
          "title": "Broker Password",
          "format": "password",
          "x-env": "MQTT_PASSWORD"
        },
        "auth_policy_file": {
          "type": "string",
          "title": "Workload Identity Policy File",
          "description": "Mounted JSON policy defining distinct principals, secret files, and least-privilege topic filters.",
          "x-env": "MQTT_AUTH_POLICY_FILE",
          "default": "/run/secrets/mqtt-policy.json"
        },
        "topic_prefix": {
          "type": "string",
          "title": "Topic Prefix",
          "x-env": "MQTT_TOPIC_PREFIX",
          "default": "piphi",
          "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
        },
        "broker_id": {
          "type": "string",
          "title": "Stable Broker ID",
          "x-env": "MQTT_BROKER_ID",
          "default": "piphi.service.mqtt-broker",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "max_connections": {
          "type": "integer",
          "title": "Maximum Connections and Managed Principals",
          "x-env": "MQTT_MAX_CONNECTIONS",
          "default": 256,
          "minimum": 1,
          "maximum": 100000
        },
        "max_packet_size": {
          "type": "integer",
          "title": "Maximum MQTT Packet Bytes",
          "x-env": "MQTT_MAX_PACKET_SIZE",
          "default": 1048576,
          "minimum": 1,
          "maximum": 268435455
        },
        "message_size_limit": {
          "type": "integer",
          "title": "Maximum MQTT Payload Bytes",
          "x-env": "MQTT_MESSAGE_SIZE_LIMIT",
          "default": 1048576,
          "minimum": 1,
          "maximum": 268435455
        },
        "max_inflight_messages": {
          "type": "integer",
          "title": "Maximum Inflight Messages Per Client",
          "x-env": "MQTT_MAX_INFLIGHT_MESSAGES",
          "default": 32,
          "minimum": 1,
          "maximum": 65535
        },
        "max_inflight_bytes": {
          "type": "integer",
          "title": "Maximum Inflight Bytes Per Client",
          "x-env": "MQTT_MAX_INFLIGHT_BYTES",
          "default": 8388608,
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_queued_messages": {
          "type": "integer",
          "title": "Maximum Offline Queued Messages Per Client",
          "x-env": "MQTT_MAX_QUEUED_MESSAGES",
          "default": 1024,
          "minimum": 1,
          "maximum": 1000000
        },
        "max_queued_bytes": {
          "type": "integer",
          "title": "Maximum Offline Queued Bytes Per Client",
          "x-env": "MQTT_MAX_QUEUED_BYTES",
          "default": 16777216,
          "minimum": 1,
          "maximum": 4294967295
        },
        "memory_limit": {
          "type": "integer",
          "title": "Broker Heap Limit Bytes",
          "x-env": "MQTT_MEMORY_LIMIT",
          "default": 268435456,
          "minimum": 1,
          "maximum": 4294967295
        },
        "minimum_free_bytes": {
          "type": "integer",
          "title": "Readiness Persistence Free-Space Floor",
          "x-env": "MQTT_MINIMUM_FREE_BYTES",
          "default": 67108864,
          "minimum": 1,
          "maximum": 1099511627776
        },
        "readiness_stale_after_seconds": {
          "type": "integer",
          "title": "Diagnostics Stale Threshold",
          "x-env": "MQTT_READINESS_STALE_AFTER_SECONDS",
          "default": 90,
          "minimum": 1,
          "maximum": 3600
        },
        "sys_interval": {
          "type": "integer",
          "title": "Aggregate Broker Metrics Interval",
          "x-env": "MQTT_SYS_INTERVAL",
          "default": 5,
          "minimum": 1,
          "maximum": 60
        },
        "tls_enabled": {
          "type": "boolean",
          "title": "Enable TLS",
          "x-env": "MQTT_TLS_ENABLED",
          "default": true
        },
        "tls_ca_file": {
          "type": "string",
          "title": "TLS CA File",
          "x-env": "MQTT_TLS_CA_FILE",
          "default": "/run/secrets/ca.crt"
        },
        "tls_cert_file": {
          "type": "string",
          "title": "TLS Certificate File",
          "x-env": "MQTT_TLS_CERT_FILE",
          "default": "/run/secrets/server.crt"
        },
        "tls_key_file": {
          "type": "string",
          "title": "TLS Private Key File",
          "x-env": "MQTT_TLS_KEY_FILE",
          "default": "/run/secrets/server.key"
        },
        "tls_require_client_certificate": {
          "type": "boolean",
          "title": "Require Client Certificates",
          "x-env": "MQTT_TLS_REQUIRE_CLIENT_CERTIFICATE",
          "default": true
        },
        "health_tls_cert_file": {
          "type": "string",
          "title": "Health Probe Client Certificate File",
          "x-env": "MQTT_HEALTH_TLS_CERT_FILE",
          "default": "/run/secrets/health-client.crt"
        },
        "health_tls_key_file": {
          "type": "string",
          "title": "Health Probe Client Key File",
          "x-env": "MQTT_HEALTH_TLS_KEY_FILE",
          "default": "/run/secrets/health-client.key"
        }
      }
    }
  },
  "exports": {
    "env": {
      "MQTT_ENABLED": "true",
      "MQTT_HOST": "mqtt-broker",
      "MQTT_PORT": "1883",
      "MQTT_TOPIC_PREFIX": "piphi",
      "MQTT_TLS_ENABLED": "true"
    }
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  }
}
