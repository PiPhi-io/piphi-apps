{
  "manifest_version": "1.0",
  "kind": "platform_service",
  "id": "piphi.service.mqtt-broker",
  "name": "MQTT Broker",
  "description": "Shared MQTT broker for PiPhi integrations and helpers.",
  "version": "0.2.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "health": {
        "type": "container"
      },
      "container": {
        "image": "ghcr.io/piphi-io/mqtt-broker:0.2.0",
        "environment": {
          "MQTT_ALLOW_PLAINTEXT": "true"
        },
        "ports": [
          {
            "container": 1883
          }
        ],
        "volumes": [
          {
            "host": "/var/lib/piphi/mqtt/config",
            "container": "/mosquitto/config"
          },
          {
            "host": "/var/lib/piphi/mqtt/data",
            "container": "/mosquitto/data"
          },
          {
            "host": "/var/lib/piphi/mqtt/log",
            "container": "/mosquitto/log"
          }
        ],
        "restart_policy": {
          "name": "unless-stopped"
        }
      }
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "required": [
        "listener_port"
      ],
      "properties": {
        "listener_port": {
          "type": "integer",
          "title": "MQTT Port",
          "x-env": "MQTT_PORT",
          "default": 1883,
          "minimum": 1,
          "maximum": 65535
        },
        "allow_plaintext": {
          "type": "boolean",
          "title": "Allow Plaintext on the Private Service Network",
          "description": "Enable only when network isolation is enforced by PiPhi Core.",
          "x-env": "MQTT_ALLOW_PLAINTEXT",
          "default": true
        },
        "username": {
          "type": "string",
          "title": "Broker Username",
          "x-env": "MQTT_USERNAME",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "password": {
          "type": "string",
          "title": "Broker Password",
          "format": "password",
          "x-env": "MQTT_PASSWORD"
        },
        "topic_prefix": {
          "type": "string",
          "title": "Topic Prefix",
          "x-env": "MQTT_TOPIC_PREFIX",
          "default": "piphi",
          "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
        },
        "tls_enabled": {
          "type": "boolean",
          "title": "Enable TLS",
          "x-env": "MQTT_TLS_ENABLED",
          "default": false
        },
        "tls_ca_file": {
          "type": "string",
          "title": "TLS CA File",
          "x-env": "MQTT_TLS_CA_FILE"
        },
        "tls_cert_file": {
          "type": "string",
          "title": "TLS Certificate File",
          "x-env": "MQTT_TLS_CERT_FILE"
        },
        "tls_key_file": {
          "type": "string",
          "title": "TLS Private Key File",
          "x-env": "MQTT_TLS_KEY_FILE"
        }
      }
    }
  },
  "exports": {
    "env": {
      "MQTT_ENABLED": "true",
      "MQTT_HOST": "mqtt-broker",
      "MQTT_PORT": "1883",
      "MQTT_TOPIC_PREFIX": "piphi"
    }
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  }
}
