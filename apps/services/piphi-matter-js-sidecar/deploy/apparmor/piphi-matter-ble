#include <tunables/global>

abi <abi/3.0>,

# Docker's default confinement with only the system-bus calls needed by the
# BlueZ D-Bus Noble binding added. Load as `piphi-matter-ble` and select it
# with `docker run --security-opt apparmor=piphi-matter-ble ...`.
profile piphi-matter-ble flags=(attach_disconnected,mediate_deleted) {
  network,
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=piphi-matter-ble,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny mount,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,tracedby,read,readby) peer=piphi-matter-ble,

  # D-Bus connection setup and match subscriptions.
  dbus send
    bus=system
    path=/org/freedesktop/DBus
    interface=org.freedesktop.DBus
    member={Hello,AddMatch,RemoveMatch,GetNameOwner,NameHasOwner}
    peer=(name=org.freedesktop.DBus),
  dbus receive bus=system peer=(name=org.freedesktop.DBus),

  # BlueZ adapter discovery, device connection, and GATT traffic only.
  dbus send bus=system path=/ peer=(name=org.bluez),
  dbus send bus=system path=/org/bluez{,/**} peer=(name=org.bluez),
  dbus receive
    bus=system
    path=/
    interface=org.freedesktop.DBus.ObjectManager
    member={InterfacesAdded,InterfacesRemoved},
  dbus receive
    bus=system
    path=/org/bluez{,/**},
}
