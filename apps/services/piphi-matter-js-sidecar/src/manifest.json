{
  "manifest_version": "1.0",
  "kind": "platform_service",
  "id": "piphi.service.matter-sidecar",
  "name": "Matter Sidecar",
  "version": "0.2.0-alpha.8",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/matter-sidecar:0.2.0-alpha.8",
        "ports": [
          {
            "container": 8710
          }
        ],
        "network_mode": "host",
        "privileged": false,
        "environment": {
          "MATTER_STORAGE_DIR": "/var/lib/piphi/matter",
          "MATTER_API_HOST": "127.0.0.1",
          "MATTER_MANAGE_BACKEND": "true",
          "MATTER_ENABLE_BLE": "false",
          "MATTER_ALLOW_CONTROL": "false",
          "MATTER_ALLOW_COMMISSIONING": "false"
        },
        "read_only": true,
        "tmpfs": ["/tmp"],
        "restart_policy": { "name": "unless-stopped", "maximum_retry_count": 0 },
        "volumes": [{ "host": "/var/lib/piphi/matter", "container": "/var/lib/piphi/matter", "mode": "rw" }]
      }
    }
  },
  "api": {
    "endpoints": {
      "health": "/health",
      "snapshot": "/v1/snapshot",
      "entities": "/entities",
      "discover": "/v1/devices/discover",
      "commissionables": "/v1/discovery/commissionables",
      "registry": "/v1/registry",
      "decommission_node": "/v1/nodes/:nodeId/decommission",
      "backup_quiesce": "/v1/admin/backup/quiesce",
      "backup_resume": "/v1/admin/backup/resume",
      "commission_code": "/v1/commission/code",
      "commission_wifi": "/v1/commission/wifi",
      "configs": "/v1/configs",
      "telemetry_poll": "/v1/telemetry/poll",
      "events": "/v1/events",
      "matter_snapshot": "/v1/matter/snapshot",
      "matter_events": "/v1/matter/events",
      "preflight": "/v1/preflight",
      "command_invoke": "/v1/commands/invoke",
      "thread_credentials_cleanup": "/v1/credentials/thread"
    }
  },
  "onboarding": {
    "mode": "service"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  }
}
