{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-washdata",
  "name": "WashData",
  "version": "0.2.0",
  "description": "Durable, read-only appliance cycle monitoring from Core-authorized power telemetry.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sensor-device",
    "domain": "sensor",
    "preset_summary": "Local device starter with polling cadence and device diagnostics hooks."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-washdata:0.2.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-washdata:0.2.0",
        "ports": [
          {
            "container": 4211,
            "host": 4211
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_WASHDATA_STATE_PATH": "/app/data/washdata-state.sqlite3",
          "PIPHI_AUTOMATION_LEDGER_PATH": "/app/data/automation-actions.sqlite3"
        },
        "volumes": [
          {"host": "/var/lib/piphi/washdata", "container": "/app/data", "mode": "rw"}
        ],
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": ["alias", "start_threshold_w", "stop_threshold_w", "start_debounce_samples", "stop_debounce_samples", "poll_interval_seconds", "page_size", "max_sample_gap_seconds"],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": ["config_id"]
  },
  "identity": {
    "fields": ["config_id"]
  },
  "capabilities": {
    "connected": {"kind": "sensor", "unit": "bool"},
    "available": {"kind": "sensor", "unit": "bool"},
    "stale": {"kind": "sensor", "unit": "bool"},
    "detector_status": {"kind": "sensor"},
    "cycle_state": {"kind": "sensor"},
    "cycle_active": {"kind": "sensor", "unit": "bool"},
    "cycle_started_at": {"kind": "sensor", "optional": true},
    "cycle_finished_at": {"kind": "sensor", "optional": true},
    "cycle_duration_s": {"kind": "sensor", "unit": "s", "optional": true},
    "power_w": {"kind": "sensor", "unit": "W", "optional": true},
    "peak_power_w": {"kind": "sensor", "unit": "W", "optional": true},
    "cycle_energy_kwh": {"kind": "sensor", "unit": "kWh"},
    "lifetime_cycle_count": {"kind": "sensor", "unit": "count"},
    "last_sample_at": {"kind": "sensor", "optional": true},
    "refresh": {"kind": "action", "read_only": true}
  },
  "commands": {"refresh": {"description": "Read one bounded source telemetry page.", "timeout_ms": 10000}},
  "entities": [
    {
      "id": "dynamic-cycle-monitor",
      "name": "Appliance cycle",
      "entity_type": "appliance_cycle",
      "capabilities": ["connected", "available", "stale", "detector_status", "cycle_state", "cycle_active", "cycle_started_at", "cycle_finished_at", "cycle_duration_s", "power_w", "peak_power_w", "cycle_energy_kwh", "lifetime_cycle_count", "last_sample_at", "refresh"],
      "available_commands": [{"id": "refresh", "label": "Refresh", "kind": "action"}]
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.washdata-status",
        "version_range": ">=0.1,<1",
        "auto_install": false
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "WashData",
    "summary": "Monitor appliance cycles from an authorized power telemetry source without controlling appliance power.",
    "category": "appliances",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-washdata/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "core_source_telemetry",
        "label": "Authorized Core source telemetry",
        "reason": "Reads only the canonical power source explicitly bound to this integration configuration by PiPhi Core.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Multi-vendor",
        "model": "Appliances observed by a bound power telemetry source"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-washdata",
    "support_url": "https://github.com/PiPhi-io/piphi-network-washdata/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-washdata/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "washing machine",
      "dryer",
      "dishwasher"
    ],
    "protocols": [
      "PiPhi Core source telemetry contract"
    ],
    "discovery_methods": [
      "Core source binding"
    ],
    "connectivity": "local",
    "offline_support": "durable last-known cycle state marked stale",
    "privacy_url": "https://github.com/PiPhi-io/piphi-network-washdata/blob/main/docs/privacy.md"
  },
  "onboarding": {
    "mode": "manual"
  }
}
