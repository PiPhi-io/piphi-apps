{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-zwave",
  "name": "Z-Wave",
  "version": "0.3.0",
  "description": "Expose command-class-negotiated Z-Wave devices through the managed Z-Wave JS sidecar.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "protocol-bridge",
    "domain": "bridge",
    "preset_summary": "Protocol bridge starter for translating an external local protocol."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-zwave:0.3.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-zwave:0.3.0",
        "ports": [
          {
            "container": 4221
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_ENV": "production",
          "PIPHI_ZWAVE_SIDECAR_URL": "http://127.0.0.1:4211",
          "PIPHI_AUTOMATION_LEDGER_PATH": "/app/data/automation-actions.sqlite3"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        },
        "volumes": [
          {
            "host": "/var/lib/piphi/zwave-integration",
            "container": "/app/data",
            "mode": "rw"
          }
        ]
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "network_id",
      "alias",
      "event_poll_interval_seconds"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "network_id"
    ]
  },
  "identity": {
    "fields": [
      "network_id"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "availability": {
      "kind": "sensor",
      "unit": "bool"
    },
    "node_status": {
      "kind": "sensor"
    },
    "switch_state": {
      "kind": "sensor",
      "unit": "bool"
    },
    "level_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "battery_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "battery_low": {
      "kind": "sensor",
      "unit": "bool"
    },
    "temperature_c": {
      "kind": "sensor",
      "unit": "\u00b0C"
    },
    "humidity_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "illuminance_lux": {
      "kind": "sensor",
      "unit": "lx"
    },
    "multilevel_sensor_value": {
      "kind": "sensor"
    },
    "meter_value": {
      "kind": "sensor"
    },
    "power_w": {
      "kind": "sensor",
      "unit": "W"
    },
    "power_kw": {
      "kind": "sensor",
      "unit": "kW"
    },
    "energy_kwh": {
      "kind": "sensor",
      "unit": "kWh"
    },
    "voltage_v": {
      "kind": "sensor",
      "unit": "V"
    },
    "current_a": {
      "kind": "sensor",
      "unit": "A"
    },
    "frequency_hz": {
      "kind": "sensor",
      "unit": "Hz"
    },
    "lock_state": {
      "kind": "sensor"
    },
    "thermostat_mode": {
      "kind": "sensor"
    },
    "thermostat_setpoint_c": {
      "kind": "sensor",
      "unit": "\u00b0C"
    },
    "refresh": {
      "kind": "action"
    },
    "ping_node": {
      "kind": "action"
    },
    "request_node_interview": {
      "kind": "action"
    },
    "reconnect_driver": {
      "kind": "action"
    },
    "set_switch": {
      "kind": "action"
    },
    "set_level": {
      "kind": "action"
    },
    "set_lock": {
      "kind": "action"
    },
    "set_thermostat_mode": {
      "kind": "action"
    },
    "set_thermostat_setpoint": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh this node's values.",
      "timeout_ms": 120000
    },
    "ping_node": {
      "description": "Check whether this node is reachable.",
      "timeout_ms": 30000
    },
    "request_node_interview": {
      "description": "Request a fresh node interview.",
      "timeout_ms": 120000
    },
    "reconnect_driver": {
      "description": "Reconnect the managed Z-Wave driver.",
      "timeout_ms": 30000
    },
    "set_switch": {
      "description": "Set a metadata-declared writable binary switch.",
      "timeout_ms": 30000
    },
    "set_level": {
      "description": "Set a metadata-declared writable multilevel value.",
      "timeout_ms": 30000
    },
    "set_lock": {
      "description": "Set a metadata-declared writable lock mode.",
      "timeout_ms": 30000
    },
    "set_thermostat_mode": {
      "description": "Set an allowed thermostat mode.",
      "timeout_ms": 30000
    },
    "set_thermostat_setpoint": {
      "description": "Set a bounded thermostat setpoint.",
      "timeout_ms": 30000
    }
  },
  "entities": [
    {
      "id": "zwave-node",
      "name": "Negotiated Z-Wave node",
      "device_id": "zwave-node",
      "entity_type": "zwave_device",
      "capabilities": [
        "connected",
        "availability",
        "node_status",
        "switch_state",
        "level_percent",
        "battery_percent",
        "battery_low",
        "temperature_c",
        "humidity_percent",
        "illuminance_lux",
        "multilevel_sensor_value",
        "meter_value",
        "power_w",
        "power_kw",
        "energy_kwh",
        "voltage_v",
        "current_a",
        "frequency_hz",
        "lock_state",
        "thermostat_mode",
        "thermostat_setpoint_c",
        "refresh",
        "ping_node",
        "request_node_interview",
        "reconnect_driver",
        "set_switch",
        "set_level",
        "set_lock",
        "set_thermostat_mode",
        "set_thermostat_setpoint"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        },
        {
          "id": "ping_node",
          "label": "Ping Node",
          "kind": "action"
        },
        {
          "id": "request_node_interview",
          "label": "Request Node Interview",
          "kind": "action"
        },
        {
          "id": "reconnect_driver",
          "label": "Reconnect Driver",
          "kind": "action"
        },
        {
          "id": "set_switch",
          "label": "Set Switch",
          "kind": "action"
        },
        {
          "id": "set_level",
          "label": "Set Level",
          "kind": "action"
        },
        {
          "id": "set_lock",
          "label": "Set Lock",
          "kind": "action"
        },
        {
          "id": "set_thermostat_mode",
          "label": "Set Thermostat Mode",
          "kind": "action"
        },
        {
          "id": "set_thermostat_setpoint",
          "label": "Set Thermostat Setpoint",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button",
          "gauge"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.zwave-status",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Z-Wave",
    "summary": "Expose command-class-negotiated Z-Wave devices through the managed Z-Wave JS sidecar.",
    "category": "other",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "sidecar_runtime",
        "label": "Managed Z-Wave sidecar",
        "reason": "Uses the authenticated local Z-Wave JS sidecar to read and control metadata-declared node values.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Z-Wave Alliance",
        "model": "Devices whose command classes are supported by the managed sidecar"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-apps/tree/apps/piphi-network-zwave/v0.3.0/apps/integrations/piphi-network-zwave",
    "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-apps/releases/tag/apps/piphi-network-zwave/v0.3.0",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "Z-Wave controller",
      "sensor",
      "switch",
      "lock",
      "climate device"
    ],
    "protocols": [
      "Z-Wave",
      "Z-Wave JS event contract"
    ],
    "discovery_methods": [
      "Z-Wave inclusion",
      "sidecar node discovery"
    ],
    "connectivity": "local",
    "offline_support": "full"
  },
  "onboarding": {
    "mode": "discovery"
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  }
}
