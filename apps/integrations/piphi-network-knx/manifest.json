{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-knx",
  "name": "KNX",
  "version": "0.2.3",
  "description": "Connect a KNX/IP tunnel and expose explicitly reviewed, typed datapoints.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "protocol-bridge",
    "domain": "bridge",
    "preset_summary": "Protocol bridge starter for translating an external local protocol."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-knx:0.2.3",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-knx:0.2.3",
        "ports": [
          {
            "container": 4223,
            "host": 4223
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_KNX_CONFIG_PATH": "/app/data/knx-configs.json",
          "PIPHI_AUTOMATION_LEDGER_PATH": "/app/data/automation-actions.sqlite3"
        },
        "volumes": [
          {
            "host": "/var/lib/piphi/knx",
            "container": "/app/data",
            "mode": "rw"
          }
        ],
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "active"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "port",
      "transport",
      "local_ip",
      "rate_limit",
      "queue_size",
      "connect_timeout_seconds",
      "command_timeout_seconds",
      "allow_writes",
      "datapoints"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host"
    ]
  },
  "identity": {
    "fields": [
      "host"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
      "datapoint_value": {
        "kind": "sensor"
      },
      "read_datapoint": {
        "kind": "action"
      },
      "write_datapoint": {
        "kind": "action"
      }
  },
  "commands": {
    "read_datapoint": {
      "description": "Request one configured datapoint's current value.",
      "timeout_ms": 10000
    },
    "write_datapoint": {
      "description": "Write one explicitly allowlisted, typed datapoint.",
      "timeout_ms": 10000
    }
  },
  "entities": [
    {
      "id": "configured-datapoint",
      "name": "Configured KNX datapoint",
      "device_id": "configured-knx-interface",
      "entity_type": "knx_datapoint",
      "capabilities": [
        "connected",
        "datapoint_value",
        "read_datapoint",
        "write_datapoint"
      ],
      "available_commands": [
        {
          "id": "read_datapoint",
          "label": "Read datapoint",
          "kind": "action"
        },
        {
          "id": "write_datapoint",
          "label": "Write datapoint",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.knx-status",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "KNX",
    "summary": "Connect an exclusive KNX/IP tunnel and expose reviewed datapoints with safe typed reads and writes.",
    "category": "other",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-knx/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Discovers or communicates with supported services and devices on the homeowner's local network.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "KNX Association",
        "model": "KNXnet/IP tunnelling interfaces using configured DPT 1.001, 5.001, or 9.001 datapoints"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-knx",
    "support_url": "https://github.com/PiPhi-io/piphi-network-knx/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-knx/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "building control",
      "light",
      "sensor"
    ],
    "protocols": [
      "KNX/IP"
    ],
    "discovery_methods": [
      "KNX/IP search",
      "manual"
    ],
    "connectivity": "local",
    "offline_support": "none"
  },
  "onboarding": {
    "mode": "manual"
  }
}
