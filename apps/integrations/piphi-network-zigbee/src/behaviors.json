{
  "behaviorSchemaVersion": "integration.behaviors.v2",
  "devices": [
    {
      "id": "piphi_network_zigbee_device",
      "name": "Zigbee device",
      "actions": [
        {
          "id": "refresh",
          "name": "Refresh state",
          "runtime": {
            "command": "refresh"
          },
          "safety": {
            "riskLevel": "low",
            "fanoutSafe": false,
            "requiresConfirmation": false
          }
        },
        {
          "id": "set_state",
          "name": "Set on/off state",
          "runtime": {
            "command": "set_state"
          },
          "safety": {
            "riskLevel": "medium",
            "fanoutSafe": false,
            "requiresConfirmation": true,
            "idempotency": "runtime_ledger"
          }
        },
        {
          "id": "set_brightness",
          "name": "Set brightness",
          "runtime": {
            "command": "set_brightness"
          },
          "safety": {
            "riskLevel": "medium",
            "fanoutSafe": false,
            "requiresConfirmation": true,
            "idempotency": "runtime_ledger"
          }
        },
        {
          "id": "set_color_temperature",
          "name": "Set color temperature",
          "runtime": {
            "command": "set_color_temperature"
          },
          "safety": {
            "riskLevel": "medium",
            "fanoutSafe": false,
            "requiresConfirmation": true,
            "idempotency": "runtime_ledger"
          }
        }
      ],
      "triggers": [
        {
          "id": "state_changed",
          "label": "State changes",
          "capability": "telemetry.state",
          "runtime": {
            "event": "device.state_changed",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 300,
            "staleDataMode": "block"
          }
        },
        {
          "id": "smoke_detected",
          "label": "Smoke detected",
          "capability": "sensor.smoke",
          "runtime": {
            "event": "zigbee.safety.smoke.detected",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 60,
            "staleDataMode": "block"
          }
        },
        {
          "id": "carbon_monoxide_detected",
          "label": "Carbon monoxide detected",
          "capability": "sensor.carbon_monoxide",
          "runtime": {
            "event": "zigbee.safety.carbon_monoxide.detected",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 60,
            "staleDataMode": "block"
          }
        },
        {
          "id": "leak_detected",
          "label": "Water leak detected",
          "capability": "sensor.water_leak",
          "runtime": {
            "event": "zigbee.safety.leak.detected",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 60,
            "staleDataMode": "block"
          }
        }
      ],
      "conditions": []
    }
  ],
  "templates": [],
  "telemetry": {
    "capabilityMappings": []
  },
  "negotiation": {
    "source": "Zigbee2MQTT exposes",
    "plannedAndExcludedAdvertised": false,
    "controlsDefaultEnabled": false
  }
}
