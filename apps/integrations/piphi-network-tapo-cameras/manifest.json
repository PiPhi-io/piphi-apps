{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-tapo-cameras",
  "name": "Tapo cameras",
  "version": "0.1.1",
  "description": "Quarantined preview. No Tapo camera transport or media functionality is implemented.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "actuator-device",
    "domain": "local-device",
    "preset_summary": "Local actuator starter with command and safety-oriented controls."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-tapo-cameras:0.1.1",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-tapo-cameras:0.1.1",
        "ports": [
          {
            "container": 4207,
            "host": 4207
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": []
  },
  "identity": {
    "fields": []
  },
  "capabilities": {},
  "commands": {},
  "entities": [],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.tapo-cameras-status",
        "version_range": ">=0.1,<1",
        "auto_install": false
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Tapo cameras",
    "summary": "Unavailable preview with no implemented Tapo transport or media functionality.",
    "category": "camera",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-tapo-cameras/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [],
    "compatibility": [],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-tapo-cameras",
    "support_url": "https://github.com/PiPhi-io/piphi-network-tapo-cameras/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-tapo-cameras/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "camera",
      "video doorbell"
    ],
    "protocols": [],
    "discovery_methods": [],
    "connectivity": "none",
    "offline_support": "none"
  },
  "onboarding": {
    "mode": "discovery"
  }
}
