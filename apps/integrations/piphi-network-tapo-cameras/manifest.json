{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-tapo-cameras",
  "name": "Tapo cameras",
  "version": "0.2.0",
  "description": "Monitor powered Tapo cameras and doorbells through an authenticated, read-only local connection.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "actuator-device",
    "domain": "local-device",
    "preset_summary": "Local actuator starter with command and safety-oriented controls."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-tapo-cameras:0.2.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-tapo-cameras:0.2.0",
        "ports": [
          {
            "container": 4207,
            "host": 4207
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "manual"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": ["host", "username", "password", "alias", "poll_interval_seconds"],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": ["config_id"]
  },
  "identity": {
    "fields": ["config_id"]
  },
  "capabilities": {
    "connected": {"kind": "sensor", "unit": "bool"},
    "available": {"kind": "sensor", "unit": "bool"},
    "stale": {"kind": "sensor", "unit": "bool"},
    "privacy_mode": {"kind": "sensor", "unit": "bool", "optional": true},
    "camera_enabled": {"kind": "sensor", "unit": "bool", "optional": true},
    "signal_strength": {"kind": "sensor", "unit": "dBm", "optional": true},
    "refresh": {"kind": "action", "read_only": true}
  },
  "commands": {
    "refresh": {"description": "Refresh read-only camera state.", "timeout_ms": 20000}
  },
  "entities": [],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.tapo-cameras-status",
        "version_range": ">=0.1,<1",
        "auto_install": false
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Tapo cameras",
    "summary": "Read-only local availability and privacy monitoring for powered Tapo cameras.",
    "category": "camera",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-tapo-cameras/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {"id": "local_network", "label": "Local network access", "reason": "Connects directly to the configured camera address.", "required": true},
      {"id": "credentials", "label": "Camera credentials", "reason": "Authenticates locally; credentials are excluded from state, events, diagnostics, and logs.", "required": true}
    ],
    "compatibility": [
      {"brand": "TP-Link Tapo", "model": "Powered cameras and doorbells supported by python-kasa 0.10.x"}
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-tapo-cameras",
    "support_url": "https://github.com/PiPhi-io/piphi-network-tapo-cameras/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-tapo-cameras/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "camera",
      "video doorbell"
    ],
    "protocols": ["Tapo local API"],
    "discovery_methods": ["authenticated targeted address"],
    "connectivity": "local",
    "offline_support": "last-known state marked stale"
  },
  "onboarding": {
    "mode": "manual"
  }
}
