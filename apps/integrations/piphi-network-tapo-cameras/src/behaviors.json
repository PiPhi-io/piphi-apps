{
  "behaviorSchemaVersion": "integration.behaviors.v2",
  "templates": [],
  "devices": [
    {
      "id": "tapo_camera",
      "name": "Tapo camera",
      "description": "Read-only powered camera availability and privacy state.",
      "deviceClass": "camera",
      "entityType": "camera",
      "capabilities": ["connected", "available", "stale", "privacy_mode", "camera_enabled", "signal_strength", "refresh"],
      "triggers": [
        {"id": "configured", "runtime": {"event": "runtime.config.applied"}},
        {"id": "unavailable", "runtime": {"event": "device.unavailable"}},
        {"id": "restored", "runtime": {"event": "device.restored"}}
      ],
      "conditions": [
        {"id": "state_matches"},
        {"id": "device_is_available"},
        {"id": "device_is_stale"},
        {"id": "privacy_mode_is"}
      ],
      "actions": [
        {
          "id": "refresh",
          "label": "Refresh",
          "runtime": {"command": "refresh"},
          "safety": {"riskLevel": "low"}
        }
      ]
    }
  ]
}
