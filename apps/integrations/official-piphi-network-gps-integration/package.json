{
  "name": "official-piphi-network-gps-integration",
  "version": "1.1.3",
  "description": "Official PiPhi Network GPS integration",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "PIPHI_ALLOW_UNAUTHENTICATED=true NODE_ENV=test tsc -p tsconfig.json && PIPHI_ALLOW_UNAUTHENTICATED=true NODE_ENV=test node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=80 dist/test/**/*.test.js",
    "start": "tsc -p tsconfig.json && node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "5.3.0",
    "express-validator": "7.3.2",
    "express-winston": "^4.2.0",
    "mqtt": "5.16.1",
    "nmea-simple": "^3.3.0",
    "piphi-runtime-kit-node": "0.7.0",
    "serialport": "^13.0.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.1",
    "piphi-runtime-testkit-node": "0.2.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "ip-address": "10.7.6",
      "lodash": "4.18.1",
      "path-to-regexp": "8.4.0",
      "ws": "8.23.0"
    }
  }
}
