{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "official-piphi-network-gps-integration",
  "source": {
    "imported_from": "https://github.com/KelvinSan/Official-PiPhi-Network-GPS-Integration"
  },
  "languages": [
    "node"
  ],
  "toolchains": {
    "node": "22"
  },
  "ci": {
    "enforcement": "full",
    "commands": [
      "corepack pnpm install --frozen-lockfile",
      "corepack pnpm audit --prod --audit-level high",
      "corepack pnpm run check",
      "corepack pnpm test",
      "corepack pnpm run build"
    ],
    "build_container": true
  },
  "packages": [
    {
      "id": "official-usb-gps-integration",
      "type": "integration",
      "version": "1.1.3",
      "manifest": "src/manifest.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "oci",
        "context": ".",
        "dockerfile": "dockerfile",
        "platforms": [
          "linux/amd64",
          "linux/arm64"
        ]
      },
      "publishing": {
        "mode": "piphi_managed",
        "environment": "release-ghcr-io",
        "primary": {
          "registry": "ghcr.io",
          "repository": "piphi-io/official-gps-integration"
        },
        "mirrors": []
      }
    }
  ]
}
