# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json tsconfig.build.json server.ts ./
COPY lib ./lib
COPY routes ./routes
RUN pnpm exec tsc -p tsconfig.build.json && pnpm prune --prod

FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
ARG RELEASE_VERSION=1.1.3
ARG SOURCE_REVISION=unknown
ARG SOURCE_REPOSITORY=https://github.com/PiPhi-io/piphi-apps
LABEL org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="${RELEASE_VERSION}"
ENV NODE_ENV=production \
    PORT=3080 \
    PIPHI_GPS_CONFIG_PATH=/var/lib/piphi/gps-configs.json
WORKDIR /app
RUN apt-get update \
    && apt-get install --yes --no-install-recommends udev=252.39-1~deb12u2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
RUN groupadd --system --gid 10001 piphi \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app piphi \
    && mkdir -p /var/lib/piphi \
    && chown -R 10001:10001 /app /var/lib/piphi
VOLUME ["/var/lib/piphi"]
EXPOSE 3080
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3080/health').then(r=>{if(!r.ok)process.exit(1)})"
CMD ["node", "dist/server.js"]
