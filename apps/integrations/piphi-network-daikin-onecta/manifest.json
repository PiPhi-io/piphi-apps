{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-daikin-onecta",
  "name": "Daikin Onecta",
  "version": "0.2.0",
  "description": "Quota-aware Daikin Onecta climate observation with opt-in bounded target-temperature control.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "cloud-polling-api",
    "domain": "cloud-api",
    "preset_summary": "Cloud API starter with vendor endpoint and token-oriented configuration."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-daikin-onecta:0.2.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-daikin-onecta:0.2.0",
        "ports": [
          {
            "container": 4215,
            "host": 4215
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "alias",
      "poll_interval_seconds",
      "enable_climate_control"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": ["config_id"]
  },
  "identity": {
    "fields": ["config_id"]
  },
  "capabilities": {
    "connected": {"kind": "sensor", "unit": "bool"},
    "available": {"kind": "sensor", "unit": "bool"},
    "stale": {"kind": "sensor", "unit": "bool"},
    "power": {"kind": "sensor", "unit": "bool", "optional": true},
    "hvac_mode": {"kind": "sensor", "optional": true},
    "indoor_temperature_c": {"kind": "sensor", "unit": "C", "optional": true},
    "target_temperature_c": {"kind": "sensor", "unit": "C", "optional": true},
    "refresh": {"kind": "action", "read_only": true},
    "set_target_temperature": {"kind": "action", "opt_in": true}
  },
  "commands": {
    "refresh": {"description": "Refresh all climate state for this account.", "timeout_ms": 20000},
    "set_target_temperature": {"description": "Set one validated climate target temperature when explicitly enabled.", "timeout_ms": 20000}
  },
  "entities": [
    {
      "id": "dynamic-climate-management-point",
      "name": "Daikin climate",
      "entity_type": "climate",
      "capabilities": ["connected", "available", "stale", "power", "hvac_mode", "indoor_temperature_c", "target_temperature_c", "refresh", "set_target_temperature"],
      "available_commands": [
        {"id": "refresh", "label": "Refresh", "kind": "action"},
        {"id": "set_target_temperature", "label": "Set target temperature", "kind": "action"}
      ]
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.daikin-onecta-status",
        "version_range": ">=0.1,<1",
        "auto_install": false
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Daikin Onecta",
    "summary": "Observe Onecta climate state account-wide and optionally set validated target temperatures.",
    "category": "climate",
    "regions": [
      "EU"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "credentials",
        "label": "Core-managed Daikin OAuth access",
        "reason": "PiPhi Core delivers the OAuth account subject and access token to the runtime; secrets are excluded from state, telemetry, events, diagnostics, and logs.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Daikin",
        "model": "Onecta-compatible residential HVAC equipment"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-apps/tree/main/apps/integrations/piphi-network-daikin-onecta",
    "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-apps/releases?q=piphi-network-daikin-onecta",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "air conditioner",
      "heat pump",
      "climate system"
    ],
    "protocols": [
      "Daikin Onecta API",
      "HTTPS"
    ],
    "discovery_methods": [
      "account discovery"
    ],
    "connectivity": "cloud",
    "offline_support": "last-known state marked stale",
    "privacy_url": "https://github.com/PiPhi-io/piphi-apps/blob/main/apps/integrations/piphi-network-daikin-onecta/docs/privacy.md"
  },
  "onboarding": {
    "mode": "account"
  }
}
