{
  "catalog_version": "1.0",
  "integration_id": "piphi-network-daikin-onecta",
  "coverage_mode": "bounded_account_wide_climate_management_points",
  "reviewed_at": "2026-11-20",
  "sources": {
    "daikin_portal": "https://developer.cloud.daikineurope.com/",
    "daikin_status": "https://daikincloudsolutions.statuspage.io/",
    "ha_daikin": "https://www.home-assistant.io/integrations/daikin/",
    "core_vocabulary": "PiPhi Network Core and maintained PiPhi integrations"
  },
  "groups": [
    {
      "id": "account-climate-observation",
      "status": "implemented",
      "scope": ["account-wide gateway devices", "climate management points"],
      "source_refs": ["daikin_portal", "ha_daikin", "core_vocabulary"],
      "reason": "One quota-aware account poll produces dynamic climate entities and preserves last-good state during provider failure.",
      "state": ["connected", "available", "stale", "power", "hvac_mode", "indoor_temperature_c", "target_temperature_c"],
      "events": ["runtime.config.applied", "onecta.account.unavailable", "onecta.account.recovered", "onecta.target_temperature.changed"],
      "conditions": ["state_matches"],
      "actions": ["refresh", "set_target_temperature"]
    },
    {
      "id": "extended-management-points",
      "status": "planned",
      "scope": ["fan", "swing", "humidity", "domestic hot water", "energy", "air quality"],
      "source_refs": ["daikin_portal", "ha_daikin"],
      "reason": "These device-specific surfaces require representative fixtures and separately bounded write semantics.",
      "state": ["fan_mode", "swing_mode", "humidity_percent", "tank_temperature_c", "energy_kwh", "air_quality_index"],
      "events": ["onecta.filter.warning", "onecta.defrost.active"],
      "conditions": ["hvac_mode_is", "temperature_above", "temperature_below"],
      "actions": ["set_hvac_mode", "set_fan_mode", "set_swing_mode", "set_hot_water_temperature"]
    },
    {
      "id": "provider-administration",
      "status": "excluded",
      "scope": ["account and device administration"],
      "source_refs": ["daikin_portal"],
      "reason": "The runtime does not enroll devices, administer accounts, update firmware, or accept arbitrary provider writes.",
      "state": ["oauth_access_token", "raw_provider_payload"],
      "events": ["oauth.token.emitted"],
      "conditions": ["raw_provider_expression"],
      "actions": ["enroll_device", "remove_device", "update_firmware", "send_arbitrary_command"]
    }
  ]
}
