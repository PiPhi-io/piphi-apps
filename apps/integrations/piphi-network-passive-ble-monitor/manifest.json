{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-passive-ble-monitor",
  "name": "Passive BLE monitor",
  "version": "0.3.0",
  "description": "Consume consented BTHome v2 observations from the managed PiPhi BLE gateway.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sensor-device",
    "domain": "sensor",
    "preset_summary": "Local device starter with polling cadence and device diagnostics hooks."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-passive-ble-monitor:0.3.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-passive-ble-monitor:0.3.0",
        "ports": [
          {
            "container": 4204,
            "host": 4204
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "gateway_url",
      "gateway_token",
      "device_handle",
      "alias",
      "poll_interval_seconds",
      "stale_after_seconds"
    ],
    "secret_fields": [
      "gateway_token"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "device_handle"
    ]
  },
  "identity": {
    "fields": [
      "device_handle"
    ]
  },
  "capabilities": {
    "receiver_healthy": {
      "kind": "sensor",
      "unit": "bool"
    },
    "observation_fresh": {"kind": "sensor", "unit": "bool"},
    "sensor_available": {"kind": "sensor", "unit": "bool"},
    "measurement_age_seconds": {"kind": "sensor", "unit": "s"},
    "temperature_c": {
      "kind": "sensor",
      "unit": "°C"
    },
    "humidity_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "battery_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "rssi_dbm": {
      "kind": "sensor",
      "unit": "dBm"
    },
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Poll the managed BLE gateway for this sensor.",
      "timeout_ms": 10000
    }
  },
  "entities": [
    {
      "id": "demo-device",
      "name": "Demo Device",
      "device_id": "demo-device",
      "entity_type": "sensor",
      "capabilities": [
        "receiver_healthy",
        "observation_fresh",
        "sensor_available",
        "measurement_age_seconds",
        "temperature_c",
        "humidity_percent",
        "battery_percent",
        "rssi_dbm",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.passive-ble-monitor-status",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Passive BLE monitor",
    "summary": "Read consented BTHome observations through the managed BLE gateway.",
    "category": "sensors",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-passive-ble-monitor/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "device_access",
        "label": "Bluetooth observation access",
        "reason": "Registers only the explicitly approved opaque device handle and BTHome service scope with the managed gateway.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Multi-vendor",
        "model": "Devices using supported passive BLE advertisement formats"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-passive-ble-monitor",
    "support_url": "https://github.com/PiPhi-io/piphi-network-passive-ble-monitor/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-passive-ble-monitor/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "environmental sensor",
      "BLE beacon",
      "battery sensor"
    ],
    "protocols": [
      "Bluetooth Low Energy"
    ],
    "discovery_methods": [
      "BLE advertisements"
    ],
    "connectivity": "local",
    "offline_support": "partial"
  },
  "onboarding": {
    "mode": "configuration"
  }
}
