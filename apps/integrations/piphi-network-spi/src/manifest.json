{
  "manifest_version": "1.0",
  "id": "piphi-network-spi",
  "name": "PiPhi Network SPI Sensors",
  "version": "0.1.4",
  "description": "Software-contract SPI sensor integration; physical SPI backends remain experimental, unverified, and disabled.",
  "maintainer": {
    "name": "PiPhi Integrations Team",
    "website": "https://github.com/PiPhi-io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/spi-integration:0.1.4",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/spi-integration:0.1.4",
        "ports": [
          {
            "container": 3675
          }
        ],
        "environment": {
          "PIPHI_SPI_PORT": "3675",
          "PIPHI_ALLOW_MOCK_HARDWARE": "false"
        },
        "privileged": false,
        "read_only": true,
        "cap_drop": ["ALL"],
        "security_opt": ["no-new-privileges:true"],
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "direct",
        "inputs": [
          {
            "name": "adapter",
            "label": "Adapter",
            "type": "select",
            "required": true,
            "options": [
              "mock"
            ],
            "description": "Only the opt-in mock backend is enabled. Physical transport settings are not part of the 0.1.4 public contract."
          },
          {
            "name": "adapter_id",
            "label": "Opaque Adapter ID",
            "type": "text",
            "required": false
          },
          {
            "name": "sensor_model",
            "label": "Sensor Model",
            "type": "select",
            "required": true,
            "options": [
              "auto",
              "bme680",
              "bme280",
              "bmp280"
            ]
          }
        ]
      }
    }
  },
  "api": {
    "base_url": "http://127.0.0.1:3675",
    "required": [
      "health",
      "diagnostics",
      "entities",
      "state",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "command": "/command",
      "config": "/config",
      "config_sync": "/configs/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "adapter",
      "adapter_id",
      "sensor_model",
      "poll_interval_seconds"
    ],
    "identity_fields": [
      "adapter",
      "adapter_id"
    ]
  },
  "identity": {
    "fields": [
      "adapter",
      "adapter_id"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "value_kind": "boolean",
      "unit": "bool",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "sensor-card",
          "availability-card"
        ],
        "default_widget": "stat"
      }
    },
    "temperature_c": {
      "kind": "sensor",
      "value_kind": "numeric",
      "unit": "C",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "sensor-card",
          "line-chart",
          "room-climate-card"
        ],
        "default_widget": "stat"
      }
    },
    "humidity_percent": {
      "kind": "sensor",
      "value_kind": "numeric",
      "unit": "%",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "sensor-card",
          "line-chart",
          "room-climate-card"
        ],
        "default_widget": "stat"
      }
    },
    "pressure_hpa": {
      "kind": "sensor",
      "value_kind": "numeric",
      "unit": "hPa",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "sensor-card",
          "line-chart",
          "weather"
        ],
        "default_widget": "stat"
      }
    },
    "gas_ohms": {
      "kind": "sensor",
      "value_kind": "numeric",
      "unit": "ohm",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "sensor-card",
          "line-chart",
          "air-quality-card"
        ],
        "default_widget": "stat"
      }
    },
    "refresh": {
      "kind": "action",
      "value_kind": "command",
      "dashboard": {
        "allowed_widgets": [
          "button",
          "command-strip"
        ],
        "default_widget": "button"
      }
    }
  },
  "commands": {
    "refresh": {
      "description": "Read the sensor immediately.",
      "timeout_ms": 5000
    }
  },
  "entities": [
    {
      "id": "spi-environmental-sensor",
      "name": "SPI Environmental Sensor",
      "device_id": "spi-environmental-sensor",
      "entity_type": "sensor",
      "capabilities": [
        "connected",
        "temperature_c",
        "humidity_percent",
        "pressure_hpa",
        "gas_ohms",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "sensor-card",
          "stat",
          "line-chart",
          "air-quality-card",
          "room-climate-card"
        ],
        "default_widget": "sensor-card"
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.spi-environment",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PIPHI_SPI_PORT"
  },
  "onboarding": {
    "mode": "discovery"
  }
}
