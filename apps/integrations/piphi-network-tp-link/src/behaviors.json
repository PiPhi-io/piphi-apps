{
  "devices": [
    {
      "id": "kasa_device",
      "name": "TP-Link Kasa Device",
      "description": "Monitoring-first metadata for negotiated local Kasa state. Consequential controls require separate model/firmware qualification and are not advertised.",
      "capabilities": [
        "switch",
        "brightness",
        "color_temperature",
        "color",
        "power",
        "temperature",
        "humidity",
        "telemetry",
        "refresh",
        "energy_power",
        "energy_today",
        "energy_this_month"
      ],
      "intents": [
        {
          "id": "automate_kasa_device",
          "label": "Automate Kasa device",
          "description": "Build automations for any supported Kasa capability"
        }
      ],
      "conditions": [
        {
          "id": "is_on",
          "label": "Power state is on",
          "type": "boolean",
          "capability": "switch.power",
          "operators": [
            "eq",
            "neq"
          ],
          "runtime": {
            "source": "state",
            "field": "is_on",
            "fieldAliases": [
              "power_state",
              "switch"
            ],
            "operator": "eq"
          },
          "freshness": {
            "maxAgeSeconds": 300,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "feature_equals",
          "label": "Feature equals value",
          "type": "text",
          "params": [
            {
              "name": "feature_id",
              "label": "Feature ID",
              "type": "text",
              "required": true
            },
            {
              "name": "value",
              "label": "Expected value",
              "type": "text",
              "required": true
            },
            {
              "name": "child_id",
              "label": "Child ID (optional)",
              "type": "text",
              "required": false
            }
          ],
          "capability": "sensor.feature_equals",
          "operators": [
            "eq",
            "neq",
            "contains"
          ],
          "runtime": {
            "source": "state",
            "field": "feature_equals",
            "operator": "eq"
          },
          "freshness": {
            "maxAgeSeconds": 300,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "feature_in_range",
          "label": "Feature in numeric range",
          "type": "number",
          "params": [
            {
              "name": "feature_id",
              "label": "Feature ID",
              "type": "text",
              "required": true
            },
            {
              "name": "min_value",
              "label": "Minimum value",
              "type": "number",
              "required": true
            },
            {
              "name": "max_value",
              "label": "Maximum value",
              "type": "number",
              "required": true
            },
            {
              "name": "child_id",
              "label": "Child ID (optional)",
              "type": "text",
              "required": false
            }
          ],
          "capability": "sensor.feature_in_range",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "feature_in_range",
            "operator": ">"
          },
          "freshness": {
            "maxAgeSeconds": 300,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "signal_below",
          "label": "Signal strength below",
          "type": "number",
          "params": [
            {
              "name": "dbm",
              "label": "Signal threshold (dBm)",
              "type": "number",
              "min": -100,
              "max": -20,
              "default": -70,
              "step": 1,
              "required": true,
              "unit": "dBm"
            }
          ],
          "capability": "sensor.signal",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "signal_strength",
            "fieldAliases": [
              "signal",
              "rssi"
            ],
            "operator": ">"
          },
          "freshness": {
            "maxAgeSeconds": 300,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "power_above",
          "label": "Power above threshold",
          "type": "number",
          "params": [
            {
              "name": "watts",
              "label": "Power threshold (W)",
              "type": "number",
              "min": 0,
              "max": 10000,
              "default": 500,
              "step": 1,
              "required": true,
              "unit": "W"
            },
            {
              "name": "child_id",
              "label": "Child ID (optional)",
              "type": "text",
              "required": false
            }
          ],
          "capability": "sensor.power",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "power",
            "operator": ">"
          },
          "freshness": {
            "maxAgeSeconds": 300,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "energy_today_above",
          "label": "Today energy above threshold",
          "type": "number",
          "params": [
            {
              "name": "kwh",
              "label": "Today energy threshold (kWh)",
              "type": "number",
              "min": 0,
              "max": 200,
              "default": 2,
              "step": 0.1,
              "required": true,
              "unit": "kWh"
            },
            {
              "name": "child_id",
              "label": "Child ID (optional)",
              "type": "text",
              "required": false
            }
          ],
          "capability": "sensor.energy",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "energy_today",
            "fieldAliases": [
              "energy",
              "today_kwh"
            ],
            "operator": ">"
          },
          "freshness": {
            "maxAgeSeconds": 300,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "only_if"
          }
        }
      ],
      "actions": [
        {
          "id": "refresh",
          "label": "Refresh state",
          "capability": "device.refresh",
          "runtime": {
            "command": "refresh"
          },
          "safety": {
            "riskLevel": "low",
            "requiresConfirmation": false,
            "liveRunAllowed": true
          },
          "targeting": {
            "fanoutSafe": true,
            "scopes": [
              "config",
              "configs",
              "room",
              "rooms",
              "group",
              "groups",
              "selection",
              "tag",
              "tags",
              "capability",
              "all_matching"
            ],
            "supportsMultiTarget": true
          },
          "failure": {
            "strategy": "retry_then_continue",
            "retry": {
              "maxAttempts": 1,
              "delaySeconds": 2,
              "backoff": "fixed"
            },
            "timeoutSeconds": 30,
            "continueOnPartialFailure": true,
            "idempotent": true
          },
          "ui": {
            "group": "do_this"
          }
        },
        {
          "id": "read_energy",
          "label": "Read energy metrics",
          "params": [
            {
              "name": "child_id",
              "label": "Child ID (optional)",
              "type": "text",
              "required": false
            }
          ],
          "capability": "action.read_energy",
          "runtime": {
            "command": "read_energy"
          },
          "safety": {
            "riskLevel": "low",
            "requiresConfirmation": false,
            "liveRunAllowed": true
          },
          "targeting": {
            "fanoutSafe": true,
            "scopes": [
              "config",
              "configs",
              "room",
              "rooms",
              "group",
              "groups",
              "selection",
              "tag",
              "tags",
              "capability",
              "all_matching"
            ],
            "supportsMultiTarget": true
          },
          "failure": {
            "strategy": "retry_then_continue",
            "retry": {
              "maxAttempts": 1,
              "delaySeconds": 2,
              "backoff": "fixed"
            },
            "timeoutSeconds": 30,
            "continueOnPartialFailure": true,
            "idempotent": true
          },
          "ui": {
            "group": "do_this"
          }
        }
      ],
      "stop": [
        {
          "id": "after_duration",
          "label": "After duration",
          "type": "duration",
          "params": [
            {
              "name": "duration",
              "label": "Duration",
              "type": "duration",
              "default": "30m",
              "required": true
            }
          ]
        },
        {
          "id": "when_condition_clears",
          "label": "When condition clears",
          "type": "boolean"
        }
      ],
      "manualOverride": [
        {
          "id": "continue",
          "label": "Continue automation"
        },
        {
          "id": "pause",
          "label": "Pause automation",
          "params": [
            {
              "name": "duration",
              "label": "Pause duration",
              "type": "duration",
              "default": "15m",
              "required": true
            }
          ]
        },
        {
          "id": "disable_behavior",
          "label": "Disable behavior"
        }
      ],
      "deviceClass": "switch_device",
      "entityType": "device",
      "targeting": {
        "scopes": [
          "config"
        ],
        "fanout": {
          "supported": false,
          "defaultMode": "config",
          "allowedModes": [
            "config"
          ]
        }
      },
      "freshness": {
        "maxAgeSeconds": 300,
        "staleDataMode": "block"
      },
      "ui": {
        "icon": "power",
        "category": "switch_device"
      },
      "triggers": [
        {
          "id": "state_changed",
          "label": "Device updates",
          "description": "Start when this device reports a new state.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "device.state_changed",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 300,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "when"
          }
        }
      ]
    }
  ],
  "templates": [],
  "behaviorSchemaVersion": "integration.behaviors.v2",
  "telemetry": {
    "capabilityMappings": [
      {
        "nativeMetric": "brightness",
        "capability": "sensor.brightness"
      },
      {
        "nativeMetric": "color",
        "capability": "sensor.color"
      },
      {
        "nativeMetric": "color_temperature",
        "capability": "sensor.color_temperature"
      },
      {
        "nativeMetric": "energy_power",
        "capability": "sensor.energy_power"
      },
      {
        "nativeMetric": "energy_this_month",
        "capability": "sensor.energy_this_month"
      },
      {
        "nativeMetric": "energy_today",
        "capability": "sensor.energy_today"
      },
      {
        "nativeMetric": "humidity",
        "capability": "sensor.humidity"
      },
      {
        "nativeMetric": "power",
        "capability": "sensor.power"
      },
      {
        "nativeMetric": "switch",
        "capability": "sensor.switch"
      },
      {
        "nativeMetric": "temperature",
        "capability": "sensor.temperature"
      }
    ]
  }
}
