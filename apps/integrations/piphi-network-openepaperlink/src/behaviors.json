{
  "behaviorSchemaVersion": "integration.behaviors.v2",
  "templates": [],
  "devices": [
    {
      "id": "openepaperlink_access_point",
      "name": "OpenEPaperLink access point",
      "description": "Read-only monitoring for a configured local access point.",
      "deviceClass": "access_point",
      "entityType": "access_point",
      "capabilities": ["connected", "ap_tag_count", "ap_pending_transfer_count", "refresh"],
      "targeting": {
        "scopes": ["config", "selection"],
        "fanout": {"supported": false, "defaultMode": "selection", "allowedModes": ["selection"]}
      },
      "freshness": {"maxAgeSeconds": 3600, "staleDataMode": "block"},
      "triggers": [
        {"id": "config_applied", "label": "Configuration applied", "capability": "runtime.configuration", "runtime": {"event": "runtime.config.applied", "source": "integration"}},
        {"id": "config_restored", "label": "Configuration restored", "capability": "runtime.configuration", "runtime": {"event": "runtime.config.restored", "source": "integration"}},
        {"id": "config_removed", "label": "Configuration removed", "capability": "runtime.configuration", "runtime": {"event": "runtime.config.removed", "source": "integration"}},
        {"id": "ap_unavailable", "label": "Access point unavailable", "capability": "connected", "runtime": {"event": "access_point.unavailable", "source": "integration"}},
        {"id": "ap_recovered", "label": "Access point recovered", "capability": "connected", "runtime": {"event": "access_point.recovered", "source": "integration"}},
        {"id": "tag_discovered", "label": "Tag discovered", "capability": "ap_tag_count", "runtime": {"event": "tag.discovered", "source": "integration"}},
        {"id": "tag_removed", "label": "Tag removed", "capability": "ap_tag_count", "runtime": {"event": "tag.removed", "source": "integration"}}
      ],
      "intents": [],
      "conditions": [],
      "actions": [
        {
          "id": "refresh",
          "label": "Refresh",
          "description": "Read the configured access point now.",
          "capability": "device.refresh",
          "capabilityRequirements": ["device.refresh"],
          "runtime": {"command": "refresh", "endpoint": "/command", "method": "POST", "timeoutSeconds": 12},
          "safety": {"riskLevel": "low", "requiresConfirmation": false, "liveRunAllowed": true},
          "targeting": {"fanoutSafe": false, "supportsMultiTarget": false, "scopes": ["selection"]},
          "failure": {"strategy": "fail", "timeoutSeconds": 12, "continueOnPartialFailure": false, "idempotent": true}
        }
      ],
      "stop": [],
      "manualOverride": []
    }
  ]
}
