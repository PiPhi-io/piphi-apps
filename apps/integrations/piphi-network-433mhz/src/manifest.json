{
  "manifest_version": "1.0",
  "id": "piphi-network-433mhz",
  "name": "PiPhi Network 433MHz Devices",
  "version": "0.2.0",
  "description": "Experimental receive-only rtl_433 integration for a bounded weather, contact, battery, and signal sensor slice.",
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "image": "ghcr.io/piphi-io/piphi-network-433mhz:0.2.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-433mhz:0.2.0",
        "ports": [
          {
            "container": 8090,
            "host": 8090
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "RTL433_DISCOVERY_WAIT_SECONDS": "8",
          "RTL433_DISCOVERY_CACHE_PATH": "/tmp/piphi-network-433mhz-discovery.json",
          "RTL433_MAX_PACKET_BYTES": "65536",
          "RTL433_DEDUP_WINDOW_SECONDS": "2",
          "RTL433_DEVICE_EXPIRY_SECONDS": "610",
          "PIPHI_AUTOMATION_LEDGER_PATH": "/tmp/piphi-network-433mhz-actions.sqlite3"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive",
        "inputs": [
          {
            "name": "radio_frequency",
            "label": "Frequency",
            "type": "text",
            "required": false,
            "placeholder": "433.92M",
            "description": "Enter a band such as 315mhz, 433mhz, 868mhz, or 915mhz, or an exact rtl_433 frequency such as 344.975M. Leave blank for the current setting."
          },
          {
            "name": "rtlsdr_device",
            "label": "USB receiver or port",
            "type": "text",
            "required": false,
            "placeholder": "auto",
            "description": "Leave blank or use auto for one receiver. With multiple receivers, enter the rtl_433 device index or selector."
          }
        ]
      }
    }
  },
  "requires": {
    "services": [
      {
        "id": "piphi.service.rtl433-bridge",
        "kind": "platform_service",
        "version_range": ">=0.2.0,<0.3.0",
        "recommended_version": "0.2.0",
        "required": true,
        "shared": true,
        "auto_install": true,
        "reason": "Listens for supported sub-GHz rtl_433 radio packets and forwards decoded packets to this integration."
      }
    ]
  },
  "api": {
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "profile",
      "model",
      "station_id",
      "channel",
      "alias"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "model",
      "station_id",
      "channel"
    ]
  },
  "identity": {
    "fields": [
      "model",
      "station_id",
      "channel"
    ]
  },
  "capabilities": {
    "temperature_c": {
      "kind": "sensor",
      "unit": "\u00b0C"
    },
    "humidity_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "battery_ok": {
      "kind": "sensor",
      "unit": "bool"
    },
    "wind_speed_kph": {
      "kind": "sensor",
      "unit": "km/h"
    },
    "rain_total_mm": {
      "kind": "sensor",
      "unit": "mm"
    },
    "contact_open": {
      "kind": "sensor",
      "unit": "bool"
    },
    "leak_detected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "signal_rssi": {
      "kind": "sensor",
      "unit": "dBm"
    },
    "signal_snr": {
      "kind": "sensor",
      "unit": "dB"
    },
    "signal_noise": {
      "kind": "sensor",
      "unit": "dB"
    },
    "clear_discovery_cache": {
      "kind": "action"
    }
  },
  "commands": {
    "clear_discovery_cache": {
      "description": "Clear the cache of recently seen rtl_433 devices.",
      "timeout_ms": 5000
    }
  },
  "security": {
    "contract_version": "1",
    "event_mappings": [
      {
        "source_event_type": "rtl433.safety.leak.detected",
        "status": "excluded",
        "device_models": [
          "rtl_433 leak_sensor profile"
        ],
        "required_permissions": [
          "rtl_433 packet receive"
        ],
        "notes": "Generic RF leak fields are not safety-qualified; canonical delivery is disabled pending model-specific hardware evidence."
      },
      {
        "source_event_type": "rtl433.safety.leak.cleared",
        "status": "excluded",
        "device_models": [
          "rtl_433 leak_sensor profile"
        ],
        "required_permissions": [
          "rtl_433 packet receive"
        ],
        "notes": "Generic RF leak fields are not safety-qualified; canonical delivery is disabled pending model-specific hardware evidence."
      },
      {
        "source_event_type": "rtl433.contact.opened",
        "status": "excluded",
        "device_models": [
          "rtl_433 contact_sensor profile"
        ],
        "required_permissions": [
          "rtl_433 packet receive"
        ],
        "notes": "An open contact is routine state and is not proof of forced entry."
      },
      {
        "source_event_type": "rtl433.packet.matched",
        "status": "excluded",
        "device_models": [
          "All rtl_433 profiles"
        ],
        "required_permissions": [
          "rtl_433 packet receive"
        ],
        "notes": "This event multiplexes weather, contact, leak, and diagnostic packets and cannot safely represent a security incident."
      }
    ]
  },
  "entities": [
    {
      "id": "temperature_c",
      "name": "Temperature",
      "capabilities": [
        "temperature_c"
      ]
    },
    {
      "id": "humidity_percent",
      "name": "Humidity",
      "capabilities": [
        "humidity_percent"
      ]
    },
    {
      "id": "battery_ok",
      "name": "Battery OK",
      "capabilities": [
        "battery_ok"
      ]
    },
    {
      "id": "wind_speed_kph",
      "name": "Wind Speed",
      "capabilities": [
        "wind_speed_kph"
      ]
    },
    {
      "id": "rain_total_mm",
      "name": "Rain Total",
      "capabilities": [
        "rain_total_mm"
      ]
    },
    {
      "id": "contact_open",
      "name": "Contact Open",
      "capabilities": [
        "contact_open"
      ]
    },
    {
      "id": "leak_detected",
      "name": "Leak Detected",
      "capabilities": [
        "leak_detected"
      ]
    },
    {
      "id": "signal_rssi",
      "name": "Signal RSSI",
      "capabilities": [
        "signal_rssi"
      ]
    },
    {
      "id": "signal_snr",
      "name": "Signal-to-noise ratio",
      "capabilities": [
        "signal_snr"
      ]
    },
    {
      "id": "signal_noise",
      "name": "Signal noise",
      "capabilities": [
        "signal_noise"
      ]
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.radio-sensors",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "433 MHz sensors (experimental)",
    "summary": "Receive a bounded set of weather, contact, battery, and radio-signal readings from rtl_433.",
    "category": "sensors",
    "device_types": ["weather sensor", "contact sensor", "battery sensor"],
    "protocols": ["rtl_433", "sub-GHz receive-only radio"],
    "regions": ["WW"],
    "languages": ["en"],
    "discovery_methods": ["local radio reception"],
    "connectivity": "local",
    "offline_support": "partial",
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "companion_service",
        "label": "Background radio service",
        "reason": "Uses the separately sandboxed rtl_433 bridge to receive decoded packets.",
        "required": true
      },
      {
        "id": "household_rf_data",
        "label": "Household radio observations",
        "reason": "Stores recent identifiers and readings for explicitly accepted local sensors.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Multi-vendor",
        "model": "Explicitly accepted rtl_433 weather/contact sensors with stable identifiers; decoder support does not imply PiPhi qualification",
        "regions": ["WW"]
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-apps/tree/apps/piphi-network-433mhz/v0.2.0/apps/integrations/piphi-network-433mhz",
    "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-apps/releases/tag/apps/piphi-network-433mhz/v0.2.0",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "beta",
      "rollout_percent": 10,
      "lifecycle_status": "active",
      "qualification": {"status": "unverified"}
    }
  },
  "runtime_contract": {
    "version": 1,
    "port_binding": "core_allocated",
    "port_env": "PORT"
  },
  "onboarding": {
    "mode": "discovery"
  }
}
