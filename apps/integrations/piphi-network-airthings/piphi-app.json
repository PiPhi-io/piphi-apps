{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "piphi-network-airthings",
  "source": {
    "imported_from": "https://github.com/PiPhi-io/piphi-network-airthings"
  },
  "languages": [
    "python"
  ],
  "toolchains": {
    "python": "3.12"
  },
  "ci": {
    "enforcement": "legacy-static",
    "commands": [
      "pdm install --check",
      "pdm run pytest"
    ],
    "build_container": false
  },
  "packages": [
    {
      "id": "airthings-consumer-cloud-api",
      "type": "integration",
      "version": "0.1.7",
      "manifest": "src/manifest.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "oci",
        "context": ".",
        "dockerfile": "Dockerfile",
        "platforms": [
          "linux/amd64",
          "linux/arm64"
        ]
      },
      "publishing": {
        "mode": "piphi_managed",
        "environment": "release-docker-io",
        "primary": {
          "registry": "docker.io",
          "repository": "piphinetwork/airthings-consumer-cloud"
        },
        "mirrors": []
      }
    },
    {
      "id": "io.piphi.airthings-air-quality",
      "type": "widget",
      "version": "0.1.7",
      "manifest": "experiences/air-quality/package.source.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "widget",
        "output": "dist"
      }
    }
  ]
}
