{
  "manifest_version": "1.0",
  "id": "airthings-consumer-cloud-api",
  "name": "Airthings (Consumer Cloud)",
  "version": "0.1.10",
  "description": "Cloud integration for Airthings consumer accounts using the official Airthings Consumer API.",
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io",
    "support_email": "support@piphi.io"
  },
  "platforms": [
    "linux",
    "windows",
    "macos"
  ],
  "runtime_requirements": [
    "cloud_account",
    "internet_access",
    "secrets_or_api_tokens"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/airthings-consumer-cloud:0.1.10",
        "read_only": true,
        "ports": [
          {
            "container": 3669,
            "host": 3669
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "direct",
        "inputs": [
          {
            "name": "client_id",
            "label": "Client ID",
            "type": "text",
            "secret": true,
            "required": true,
            "description": "Consumer API client id created from the Airthings dashboard integrations page."
          },
          {
            "name": "client_secret",
            "label": "Client Secret",
            "type": "password",
            "secret": true,
            "required": true,
            "description": "Consumer API client secret for the Airthings account that owns the devices."
          },
          {
            "name": "account_id",
            "label": "Account ID",
            "type": "text",
            "secret": true,
            "required": true,
            "description": "Explicit Airthings consumer account ID. PiPhi never silently selects an account."
          }
        ]
      }
    },
    "windows": {
      "type": "proxy",
      "proxy": {
        "port": 3669
      },
      "discovery": {
        "method": "proxy",
        "inputs": [
          {
            "name": "client_id",
            "label": "Client ID",
            "type": "text",
            "secret": true,
            "required": true
          },
          {
            "name": "client_secret",
            "label": "Client Secret",
            "type": "password",
            "secret": true,
            "required": true
          },
          {
            "name": "account_id",
            "label": "Account ID",
            "type": "text",
            "secret": true,
            "required": true
          }
        ]
      }
    },
    "macos": {
      "type": "proxy",
      "proxy": {
        "port": 3669
      },
      "discovery": {
        "method": "proxy",
        "inputs": [
          {
            "name": "client_id",
            "label": "Client ID",
            "type": "text",
            "secret": true,
            "required": true
          },
          {
            "name": "client_secret",
            "label": "Client Secret",
            "type": "password",
            "secret": true,
            "required": true
          },
          {
            "name": "account_id",
            "label": "Account ID",
            "type": "text",
            "secret": true,
            "required": true
          }
        ]
      }
    }
  },
  "api": {
    "base_url": "http://127.0.0.1:3669",
    "endpoints": {
      "contract": "/contract",
      "health": "/health",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "command": "/command",
      "config": "/config",
      "config_sync": "/configs/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "diagnostics": "/diagnostics"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true
  },
  "identity": {
    "fields": [
      "device_ref"
    ]
  },
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.airthings-air-quality",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "capabilities": {
    "radon_short_term_bqm3": {
      "kind": "sensor",
      "unit": "Bq/m3",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "stat"
      }
    },
    "radon_long_term_bqm3": {
      "kind": "sensor",
      "unit": "Bq/m3",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "stat"
      }
    },
    "temperature_c": {
      "kind": "sensor",
      "unit": "\u00b0C",
      "dashboard": {
        "allowed_widgets": [
          "sensor-card",
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "sensor-card"
      }
    },
    "humidity_percent": {
      "kind": "sensor",
      "unit": "%",
      "dashboard": {
        "allowed_widgets": [
          "sensor-card",
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "sensor-card"
      }
    },
    "mold_risk_level": {
      "kind": "sensor",
      "unit": "score",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "stat"
      }
    },
    "pressure_hpa": {
      "kind": "sensor",
      "unit": "hPa",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "stat"
      }
    },
    "co2_ppm": {
      "kind": "sensor",
      "unit": "ppm",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "stat"
      }
    },
    "voc_ppb": {
      "kind": "sensor",
      "unit": "ppb",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "stat"
      }
    },
    "pm1_ugm3": {
      "kind": "sensor",
      "unit": "\u00b5g/m3",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "stat"
      }
    },
    "pm25_ugm3": {
      "kind": "sensor",
      "unit": "\u00b5g/m3",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "line-chart",
          "gauge"
        ],
        "default_widget": "stat"
      }
    },
    "battery_percent": {
      "kind": "sensor",
      "unit": "%",
      "dashboard": {
        "allowed_widgets": [
          "stat",
          "gauge"
        ],
        "default_widget": "gauge"
      }
    },
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Fetch and store a fresh reading from the Airthings Consumer Cloud API.",
      "timeout_ms": 15000
    }
  },
  "entities": [
    {
      "id": "airthings_cloud_monitor",
      "name": "Airthings Cloud Monitor",
      "device_class": "air_quality_monitor",
      "entity_type": "sensor",
      "capabilities": [
        "radon_short_term_bqm3",
        "radon_long_term_bqm3",
        "temperature_c",
        "humidity_percent",
        "mold_risk_level",
        "pressure_hpa",
        "co2_ppm",
        "voc_ppb",
        "pm1_ugm3",
        "pm25_ugm3",
        "battery_percent",
        "refresh"
      ]
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Airthings Consumer Cloud",
    "summary": "Monitor indoor air quality from supported Airthings devices through the official Consumer API.",
    "category": "air_quality",
    "regions": [
      "Global"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "credentials",
        "label": "Airthings Consumer API credentials",
        "reason": "Authenticates only to the explicitly configured Airthings consumer account; credentials remain outside state, telemetry, events, diagnostics, discovery output, logs, and errors.",
        "required": true
      },
      {
        "id": "cloud_account",
        "label": "Airthings account and device readings",
        "reason": "Lists devices in the selected account and reads their latest air-quality measurements through the official Consumer API.",
        "required": true
      },
      {
        "id": "internet_access",
        "label": "Outbound HTTPS access",
        "reason": "Connects to Airthings OAuth and Consumer API endpoints for authentication, device discovery, and quota-conscious polling.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Airthings",
        "model": "Wave Plus, Wave Radon, Wave Mini, Wave Enhance, View Plus, View Radon, and Corentium Home 2 devices available through the Consumer API"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-apps/tree/main/apps/integrations/piphi-network-airthings",
    "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-apps/releases?q=airthings-consumer-cloud-api",
    "quality_tier": "bronze",
    "governance": {
      "schema_version": 1,
      "publication_status": "beta",
      "rollout_percent": 1,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "indoor air quality monitor",
      "radon monitor"
    ],
    "protocols": [
      "Airthings Consumer API",
      "OAuth 2.0",
      "HTTPS"
    ],
    "discovery_methods": [
      "authenticated account device discovery"
    ],
    "connectivity": "cloud",
    "offline_support": "none",
    "privacy_url": "https://github.com/PiPhi-io/piphi-apps/blob/main/apps/integrations/piphi-network-airthings/docs/privacy.md"
  },
  "onboarding": {
    "mode": "account"
  }
}
