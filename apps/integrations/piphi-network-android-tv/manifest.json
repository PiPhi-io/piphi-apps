{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-android-tv",
  "name": "Android TV",
  "version": "0.3.0-rc.2",
  "description": "Control Android TV devices using explicit Remote Protocol v2 or bounded managed ADB transport.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "protocol-bridge",
    "domain": "bridge",
    "preset_summary": "Protocol bridge starter for translating an external local protocol."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-android-tv:0.3.0-rc.2",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-android-tv:0.3.0-rc.2",
        "ports": [
          {
            "container": 4220,
            "host": 4220
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_ENV": "production",
          "PIPHI_ANDROID_ADB_SIDECAR_URL": "http://piphi-android-adb-sidecar:4213",
          "PIPHI_ANDROID_TV_CREDENTIAL_DIR": "/app/data/android-tv-credentials"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        },
        "volumes": [
          {
            "host": "/var/lib/piphi/android-tv",
            "container": "/app/data",
            "mode": "rw"
          }
        ]
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "requires": {
    "services": [
      {
        "id": "piphi-android-adb-sidecar",
        "kind": "platform_service",
        "version_range": ">=0.3.0-rc.2,<0.4.0",
        "recommended_version": "0.3.0-rc.2",
        "required": true,
        "shared": true,
        "auto_install": true,
        "reason": "Owns authenticated network ADB sessions, opaque target leases, bounded command queues, and strict property and key allow-lists."
      }
    ]
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "pairing_start": "/pairing/start",
      "pairing_finish": "/pairing/{session_id}/finish",
      "adb_pairing": "/pairing/adb",
      "forget_credentials": "/pairing/credentials/{config_id}",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "transport",
      "enable_controls",
      "adb_port",
      "adb_queue_capacity",
      "adb_connect_timeout_ms",
      "adb_operation_timeout_ms"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "id"
    ]
  },
  "identity": {
    "fields": [
      "id"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "authenticated": {
      "kind": "sensor",
      "unit": "bool"
    },
    "reauth_required": {
      "kind": "sensor",
      "unit": "bool"
    },
    "power_on": {
      "kind": "sensor",
      "unit": "bool"
    },
    "current_app_id": {
      "kind": "sensor",
      "unit": "string"
    },
    "volume_level_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "muted": {
      "kind": "sensor",
      "unit": "bool"
    },
    "manufacturer": {
      "kind": "sensor",
      "unit": "string"
    },
    "model": {
      "kind": "sensor",
      "unit": "string"
    },
    "software_version": {
      "kind": "sensor",
      "unit": "string"
    },
    "transport_type": {"kind": "sensor", "unit": "string"},
    "adb_authorized": {"kind": "sensor", "unit": "bool"},
    "android_version": {"kind": "sensor", "unit": "string"},
    "android_api_level": {"kind": "sensor", "unit": "string"},
    "sidecar_queue_depth": {"kind": "sensor", "unit": "commands"},
    "sidecar_queue_capacity": {"kind": "sensor", "unit": "commands"},
    "sidecar_reconnect_count": {"kind": "sensor", "unit": "count"},
    "sidecar_command_timeout_count": {"kind": "sensor", "unit": "count"},
    "sidecar_last_error_code": {"kind": "sensor", "unit": "string"},
    "refresh": {
      "kind": "action"
    },
    "send_key": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 5000
    },
    "send_key": {
      "description": "Send one allow-listed short key press.",
      "timeout_ms": 5000
    }
  },
  "entities": [],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.android-tv-status",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Android TV",
    "summary": "Control Android TV using explicit Remote v2 or a bounded managed ADB sidecar.",
    "category": "media",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-android-tv/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Discovers or communicates with supported services and devices on the homeowner's local network.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Google Android TV",
        "model": "Android TV and Google TV devices with Android TV Remote Service"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-android-tv",
    "support_url": "https://github.com/PiPhi-io/piphi-network-android-tv/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-android-tv/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "television",
      "streaming device"
    ],
    "protocols": [
      "Android TV Remote Protocol v2",
      "Android Debug Bridge (managed bounded transport)"
    ],
    "discovery_methods": [
      "Remote v2 mDNS candidates",
      "manual"
    ],
    "connectivity": "local",
    "offline_support": "none"
  },
  "onboarding": {
    "mode": "discovery"
  }
}
