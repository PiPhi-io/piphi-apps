{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "piphi-network-matter",
  "source": { "imported_from": "https://github.com/PiPhi-io/piphi-apps" },
  "languages": ["node"],
  "toolchains": { "node": "22" },
  "ci": {
    "enforcement": "full",
    "commands": ["npm ci", "npm --prefix ../../services/piphi-matter-js-sidecar ci", "npm audit --omit=dev --audit-level=high", "npm run check", "npm test", "npm run test:coverage", "npm run build"],
    "build_container": true
  },
  "packages": [{
    "id": "piphi-network-matter-integration",
    "type": "integration",
    "version": "0.1.1",
    "manifest": "manifest.json",
    "release": { "tag": "apps/{package_id}/v{version}", "commands": [] },
    "artifact": {
      "kind": "oci",
      "context": ".",
      "dockerfile": "Dockerfile",
      "platforms": ["linux/amd64", "linux/arm64"]
    },
    "publishing": {
      "mode": "piphi_managed",
      "environment": "release-ghcr-io",
      "primary": { "registry": "ghcr.io", "repository": "piphi-io/piphi-network-matter-integration" },
      "mirrors": []
    }
  }]
}
