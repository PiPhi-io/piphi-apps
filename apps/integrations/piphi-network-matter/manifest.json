{
  "manifest_version": "1.0",
  "id": "piphi-network-matter-integration",
  "name": "Matter",
  "version": "0.1.3",
  "description": "Projects commissioned Matter endpoints from the authenticated managed sidecar into PiPhi Core.",
  "maintainer": { "name": "PiPhi Network", "website": "https://piphi.io" },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-matter-integration:0.1.3",
  "platforms": ["linux"],
  "runtime": { "linux": { "type": "container", "container": {
    "image": "ghcr.io/piphi-io/piphi-network-matter-integration:0.1.3",
    "ports": [{ "container": 4221 }],
    "network_mode": "host",
    "privileged": false,
    "environment": { "PIPHI_MATTER_SIDECAR_URL": "http://127.0.0.1:8710", "PIPHI_MATTER_RECONCILE_INTERVAL_MS": "5000", "PIPHI_MATTER_ALLOW_CONTROL": "false" },
    "read_only": true,
    "tmpfs": ["/tmp"],
    "restart_policy": { "name": "unless-stopped", "maximum_retry_count": 0 },
    "volumes": [{ "host": "/var/lib/piphi/matter-integration", "container": "/app/data", "mode": "rw" }]
  }, "discovery": { "method": "passive" } } },
  "requires": { "services": [{
    "id": "piphi.service.matter-sidecar", "kind": "platform_service",
    "version_range": ">=0.2.0-alpha.8,<0.3.0", "required": true, "shared": true, "auto_install": true,
    "reason": "Owns the persistent Matter controller/fabric and provides the authenticated snapshot, event, commissioning, and command contract."
  }] },
  "api": { "required": ["health", "entities", "command", "config"], "endpoints": {
    "health": "/health", "entities": "/entities", "state": "/state", "config": "/config", "command": "/command", "events": "/events", "diagnostics": "/diagnostics", "repairs": "/repairs", "preflight": "/preflight", "commissionables": "/commissioning/commissionables", "commission": "/commissioning/code", "commission_wifi": "/commissioning/wifi", "decommission_node": "/nodes/:nodeId/decommission", "backup_quiesce": "/backup/quiesce", "backup_resume": "/backup/resume"
  } },
  "config": {
    "source": "endpoint", "endpoint": "/config", "required": true,
    "editable_fields": ["node_id", "endpoint_id", "alias", "enabled"],
    "runtime_fields": ["config_id", "container_id", "device_id"],
    "identity_fields": ["controller_identity_hash", "node_id", "endpoint_id"]
  },
  "identity": { "fields": ["controller_identity_hash", "node_id", "endpoint_id"] },
  "capabilities": {
    "connected": { "kind": "sensor", "unit": "bool" },
    "switch_on": { "kind": "sensor", "unit": "bool" },
    "brightness_percent": { "kind": "sensor", "unit": "%" },
    "temperature_c": { "kind": "sensor", "unit": "degC" },
    "humidity_percent": { "kind": "sensor", "unit": "%" },
    "battery_percent": { "kind": "sensor", "unit": "%" },
    "contact_open": { "kind": "sensor", "unit": "bool" },
    "occupancy_detected": { "kind": "sensor", "unit": "bool" },
    "illuminance_raw": { "kind": "sensor", "unit": "matter_encoded_lux" },
    "refresh": { "kind": "action", "read_only": true },
    "turn_on": { "kind": "action" },
    "turn_off": { "kind": "action" },
    "toggle": { "kind": "action" }
  },
  "commands": {
    "refresh": { "description": "Refresh one negotiated endpoint.", "timeout_ms": 15000 },
    "turn_on": { "description": "Turn on an On/Off endpoint.", "timeout_ms": 30000 },
    "turn_off": { "description": "Turn off an On/Off endpoint.", "timeout_ms": 30000 },
    "toggle": { "description": "Toggle an On/Off endpoint.", "timeout_ms": 30000 }
  },
  "entities": [{
    "id": "matter-endpoint", "name": "Negotiated Matter endpoint", "device_id": "matter-endpoint",
    "entity_type": "matter_device", "capabilities": ["connected", "switch_on", "brightness_percent", "temperature_c", "humidity_percent", "battery_percent", "contact_open", "occupancy_detected", "illuminance_raw", "refresh", "turn_on", "turn_off", "toggle"],
    "available_commands": [
      { "id": "refresh", "label": "Refresh", "kind": "action" },
      { "id": "turn_on", "label": "Turn on", "kind": "action" },
      { "id": "turn_off", "label": "Turn off", "kind": "action" },
      { "id": "toggle", "label": "Toggle", "kind": "action" }
    ],
    "dashboard": { "allowed_widgets": ["tile", "button"], "default_widget": "tile" }
  }],
  "marketplace": {
    "metadata_version": 2, "display_name": "Matter", "summary": "Core projection for the managed Matter sidecar.",
    "category": "other", "regions": ["WW"], "languages": ["en"],
    "publisher": { "name": "PiPhi Network", "website_url": "https://piphi.io", "support_url": "https://github.com/PiPhi-io/piphi-apps/issues", "security_contact": "support@piphi.io" },
    "access": [{ "id": "sidecar_runtime", "label": "Managed Matter sidecar", "reason": "Reads endpoint snapshots and invokes negotiated commands.", "required": true }],
    "compatibility": [{ "brand": "Connectivity Standards Alliance", "model": "Negotiated On/Off endpoints plus fixture-backed read-only sensor clusters" }],
    "documentation_url": "https://github.com/PiPhi-io/piphi-apps/tree/main/apps/integrations/piphi-network-matter",
    "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-apps/releases/tag/apps/piphi-network-matter-integration/v0.1.3",
    "quality_tier": "unrated",
    "governance": { "schema_version": 1, "publication_status": "draft", "rollout_percent": 0, "lifecycle_status": "active", "qualification": { "status": "unverified" } },
    "device_types": ["switch", "light", "plug"], "protocols": ["Matter sidecar HTTP contract"],
    "discovery_methods": ["sidecar snapshot"], "connectivity": "local", "offline_support": "partial"
  },
  "onboarding": { "mode": "discovery" },
  "runtime_contract": { "version": 1, "port_binding": "core_allocated", "port_env": "PORT" }
}
