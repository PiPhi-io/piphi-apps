{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-kaiterra-api",
  "name": "PiPhi Network Kaiterra API",
  "version": "0.1.6",
  "description": "PiPhi integration runtime for Kaiterra devices using the Kaiterra public API.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.2.0",
    "preset": "cloud-polling-api",
    "domain": "cloud-api",
    "preset_summary": "Cloud API starter with vendor endpoint and token-oriented configuration."
  },
  "maintainer": {
    "name": "PiPhi Integrations Team",
    "website": "https://github.com/PiPhi-io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/kaiterra-api:0.1.6",
  "runtime_requirements": [
    "internet_access",
    "secrets_or_api_tokens",
    "persistent_app_data"
  ],
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/kaiterra-api:0.1.6",
        "read_only": true,
        "ports": [
          {
            "container": 8090,
            "host": 8090
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "direct",
        "inputs": [
          {"name": "device_udid", "label": "Device UDID", "type": "password", "secret": true, "required": true},
          {"name": "api_key", "label": "API key", "type": "password", "secret": true, "required": true}
        ]
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "device_udid",
      "alias",
      "api_key",
      "poll_interval_seconds"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "device_ref"
    ]
  },
  "identity": {
    "fields": [
      "device_ref"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "available": {"kind": "sensor", "unit": "bool"},
    "stale": {"kind": "sensor", "unit": "bool"},
    "temperature_c": {
      "kind": "sensor",
      "unit": "C"
    },
    "refresh": {
      "kind": "action"
    },
    "api_rate_limit_remaining": {
      "kind": "sensor",
      "unit": "requests"
    },
    "api_latency_ms": {
      "kind": "sensor",
      "unit": "ms"
    },
    "co2_ppm": {
      "kind": "sensor",
      "unit": "ppm"
    },
    "humidity_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "pm1_ug_m3": {
      "kind": "sensor",
      "unit": "ug/m3"
    },
    "pm25_ug_m3": {
      "kind": "sensor",
      "unit": "ug/m3"
    },
    "pm10_ug_m3": {
      "kind": "sensor",
      "unit": "ug/m3"
    },
    "tvoc_ppb": {
      "kind": "sensor",
      "unit": "ppb"
    },
    "ozone_ppb": {
      "kind": "sensor",
      "unit": "ppb"
    },
    "pressure_pa": {"kind": "sensor", "unit": "Pa"},
    "illuminance_lux": {"kind": "sensor", "unit": "lx"},
    "color_temperature_k": {"kind": "sensor", "unit": "K"},
    "co_ppm": {"kind": "sensor", "unit": "ppm"},
    "no2_ppb": {"kind": "sensor", "unit": "ppb"},
    "sync_cloud": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 5000
    },
    "sync_cloud": {
      "description": "Synchronize state from the vendor cloud.",
      "timeout_ms": 15000
    }
  },
  "entities": [],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.kaiterra-air-quality",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "onboarding": {
    "mode": "account"
  },
  "marketplace": {
    "metadata_version": 2,
    "brand_domain": "kaiterra.com",
    "display_name": "Kaiterra Air Quality",
    "summary": "Read the latest measurements from one explicitly selected Kaiterra monitor.",
    "category": "air_quality",
    "device_types": ["air_quality_monitor"],
    "protocols": ["kaiterra_api"],
    "regions": ["WW"],
    "languages": ["en"],
    "discovery_methods": ["direct"],
    "connectivity": "cloud",
    "offline_support": "stale_last_good",
    "publisher": {
      "name": "PiPhi Integrations Team",
      "website_url": "https://github.com/PiPhi-io",
      "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {"id": "external_cloud", "label": "External cloud access", "reason": "Reads latest measurements and minimal model metadata for the explicitly selected device.", "required": true},
      {"id": "credentials", "label": "API credentials", "reason": "Uses a revocable Kaiterra API key and device UDID; both remain secret runtime configuration.", "required": true}
    ],
    "compatibility": [
      {"brand": "Kaiterra", "model": "Public API compatible air-quality monitors", "regions": ["WW"]}
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-apps/tree/main/apps/integrations/piphi-network-kaiterra-api",
    "support_url": "https://github.com/PiPhi-io/piphi-apps/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-apps/releases",
    "privacy_url": "https://github.com/PiPhi-io/piphi-apps/blob/main/apps/integrations/piphi-network-kaiterra-api/docs/privacy.md",
    "quality_tier": "bronze",
    "governance": {
      "schema_version": 1,
      "publication_status": "stable",
      "rollout_percent": 100,
      "lifecycle_status": "active",
      "qualification": {"status": "unverified"}
    }
  }
}
