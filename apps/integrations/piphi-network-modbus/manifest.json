{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-modbus",
  "name": "Modbus",
  "version": "0.10.0",
  "description": "Monitor and safely control profile-declared Modbus TCP, TLS, UDP, RTU-over-TCP, RTU, and ASCII points.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "protocol-bridge",
    "domain": "bridge",
    "preset_summary": "Protocol bridge starter for translating an external local protocol."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-modbus:0.10.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-modbus:0.10.0",
        "ports": [
          {
            "container": 4222,
            "host": 4222
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_ENV": "production",
          "PIPHI_MODBUS_SIDECAR_URL": "http://piphi-modbus-rtu-sidecar:4212"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "requires": {
    "services": [
      {
        "id": "piphi-modbus-rtu-sidecar",
        "kind": "platform_service",
        "version_range": ">=0.8.0,<0.9.0",
        "recommended_version": "0.8.0",
        "required": true,
        "shared": true,
        "auto_install": true,
        "reason": "Owns authenticated serial access, RTU/ASCII framing, bounded request arbitration, and read/write execution for profile-declared serial points."
      }
    ]
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "transport",
      "register_address",
      "unit_id",
      "poll_interval_seconds",
      "poll_groups",
      "inter_message_delay_ms",
      "poll_jitter_percent",
      "poll_backoff_max_seconds",
      "response_timeout_seconds",
      "serial_port",
      "baud_rate",
      "parity",
      "stop_bits",
      "data_bits",
      "tls_ca_certificate",
      "tls_server_name",
      "profile_id",
      "profile_version",
      "profile_provenance",
      "points",
      "coil_commands"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host"
    ]
  },
  "identity": {
    "fields": [
      "host"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "holding_register_value": {
      "kind": "sensor",
      "value_kind": "numeric"
    },
    "point_value": {
      "kind": "sensor",
      "value_kind": "numeric_or_boolean"
    },
    "power": {
      "kind": "sensor",
      "unit": "bool"
    },
    "brightness_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "color_temp_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "fan_speed_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "oscillating": {
      "kind": "sensor",
      "unit": "bool"
    },
    "position_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "movement_state": {
      "kind": "sensor",
      "unit": "string"
    },
    "temperature_c": {
      "kind": "sensor",
      "unit": "C"
    },
    "target_temperature_c": {
      "kind": "sensor",
      "unit": "C"
    },
    "mode": {
      "kind": "sensor",
      "unit": "string"
    },
    "refresh": {
      "kind": "action"
    },
    "set_value": {
      "kind": "action"
    },
    "run_coil_command": {
      "kind": "action"
    },
    "turn_on": {
      "kind": "action"
    },
    "turn_off": {
      "kind": "action"
    },
    "set_brightness": {
      "kind": "action"
    },
    "set_color_temp": {
      "kind": "action"
    },
    "set_mode": {
      "kind": "action"
    },
    "set_fan_speed": {
      "kind": "action"
    },
    "set_oscillate": {
      "kind": "action"
    },
    "open_cover": {
      "kind": "action"
    },
    "close_cover": {
      "kind": "action"
    },
    "stop_cover": {
      "kind": "action"
    },
    "set_cover_position": {
      "kind": "action"
    },
    "set_temperature": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 12000
    },
    "set_value": {
      "description": "Set a profile-declared writable point within its bounds.",
      "timeout_ms": 30000
    },
    "run_coil_command": {
      "description": "Run a reviewed profile-declared multiple-coil command.",
      "timeout_ms": 90000,
      "args_schema": {
        "command_id": {
          "type": "string",
          "required": true
        }
      }
    },
    "turn_on": {
      "description": "Turn on a profile-composed device.",
      "timeout_ms": 30000
    },
    "turn_off": {
      "description": "Turn off a profile-composed device.",
      "timeout_ms": 30000
    },
    "set_brightness": {
      "description": "Set profile-composed light brightness.",
      "timeout_ms": 30000,
      "args_schema": {
        "brightness": {
          "type": "number",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "unit": "%"
        }
      }
    },
    "set_color_temp": {
      "description": "Set profile-composed light color temperature.",
      "timeout_ms": 30000,
      "args_schema": {
        "color_temp": {
          "type": "number",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "unit": "%"
        }
      }
    },
    "set_mode": {
      "description": "Set a reviewed profile mode.",
      "timeout_ms": 30000,
      "args_schema": {
        "mode": {
          "type": "string",
          "required": true
        }
      }
    },
    "set_fan_speed": {
      "description": "Set profile-composed fan speed.",
      "timeout_ms": 30000,
      "args_schema": {
        "speed": {
          "type": "number",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "unit": "%"
        }
      }
    },
    "set_oscillate": {
      "description": "Set profile-composed fan oscillation.",
      "timeout_ms": 30000,
      "args_schema": {
        "oscillating": {
          "type": "boolean",
          "required": true
        }
      }
    },
    "open_cover": {
      "description": "Open a profile-composed cover.",
      "timeout_ms": 30000
    },
    "close_cover": {
      "description": "Close a profile-composed cover.",
      "timeout_ms": 30000
    },
    "stop_cover": {
      "description": "Stop a profile-composed cover.",
      "timeout_ms": 30000
    },
    "set_cover_position": {
      "description": "Set profile-composed cover position.",
      "timeout_ms": 30000,
      "args_schema": {
        "position": {
          "type": "number",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "unit": "%"
        }
      }
    },
    "set_temperature": {
      "description": "Set profile-composed target temperature.",
      "timeout_ms": 30000,
      "args_schema": {
        "temperature_c": {
          "type": "number",
          "required": true,
          "unit": "C"
        }
      }
    }
  },
  "entities": [
    {
      "id": "demo-device",
      "name": "Demo Device",
      "device_id": "demo-device",
      "entity_type": "modbus_device",
      "capabilities": [
        "connected",
        "holding_register_value",
        "point_value",
        "power",
        "brightness_percent",
        "color_temp_percent",
        "fan_speed_percent",
        "oscillating",
        "position_percent",
        "movement_state",
        "temperature_c",
        "target_temperature_c",
        "mode",
        "refresh",
        "set_value",
        "run_coil_command",
        "turn_on",
        "turn_off",
        "set_brightness",
        "set_color_temp",
        "set_mode",
        "set_fan_speed",
        "set_oscillate",
        "open_cover",
        "close_cover",
        "stop_cover",
        "set_cover_position",
        "set_temperature"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        },
        {
          "id": "set_value",
          "label": "Set Value",
          "kind": "action"
        },
        {
          "id": "run_coil_command",
          "label": "Run Coil Command",
          "kind": "action",
          "args_schema": {
            "command_id": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "id": "turn_on",
          "label": "Turn On",
          "kind": "action"
        },
        {
          "id": "turn_off",
          "label": "Turn Off",
          "kind": "action"
        },
        {
          "id": "set_brightness",
          "label": "Set Brightness",
          "kind": "action",
          "args_schema": {
            "brightness": {
              "type": "number",
              "required": true,
              "minimum": 0,
              "maximum": 100,
              "unit": "%"
            }
          }
        },
        {
          "id": "set_color_temp",
          "label": "Set Color Temp",
          "kind": "action",
          "args_schema": {
            "color_temp": {
              "type": "number",
              "required": true,
              "minimum": 0,
              "maximum": 100,
              "unit": "%"
            }
          }
        },
        {
          "id": "set_mode",
          "label": "Set Mode",
          "kind": "action",
          "args_schema": {
            "mode": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "id": "set_fan_speed",
          "label": "Set Fan Speed",
          "kind": "action",
          "args_schema": {
            "speed": {
              "type": "number",
              "required": true,
              "minimum": 0,
              "maximum": 100,
              "unit": "%"
            }
          }
        },
        {
          "id": "set_oscillate",
          "label": "Set Oscillate",
          "kind": "action",
          "args_schema": {
            "oscillating": {
              "type": "boolean",
              "required": true
            }
          }
        },
        {
          "id": "open_cover",
          "label": "Open Cover",
          "kind": "action"
        },
        {
          "id": "close_cover",
          "label": "Close Cover",
          "kind": "action"
        },
        {
          "id": "stop_cover",
          "label": "Stop Cover",
          "kind": "action"
        },
        {
          "id": "set_cover_position",
          "label": "Set Cover Position",
          "kind": "action",
          "args_schema": {
            "position": {
              "type": "number",
              "required": true,
              "minimum": 0,
              "maximum": 100,
              "unit": "%"
            }
          }
        },
        {
          "id": "set_temperature",
          "label": "Set Temperature",
          "kind": "action",
          "args_schema": {
            "temperature_c": {
              "type": "number",
              "required": true,
              "unit": "C"
            }
          }
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.modbus-register",
        "version_range": ">=0.1,<1",
        "auto_install": true
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Modbus",
    "summary": "Profile-driven Modbus network and serial monitoring with constrained controls.",
    "category": "other",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-modbus/issues",
      "security_contact": "support@piphi.io"
    },
    "access_declared": true,
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Discovers or communicates with supported services and devices on the homeowner's local network.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Multi-vendor",
        "model": "Local Modbus TCP or RTU device with reviewed point profiles"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-modbus",
    "support_url": "https://github.com/PiPhi-io/piphi-network-modbus/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-modbus/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "Modbus TCP server",
      "Modbus RTU device"
    ],
    "protocols": [
      "Modbus TCP",
      "Modbus RTU"
    ],
    "discovery_methods": [
      "manual"
    ],
    "connectivity": "local",
    "offline_support": "none"
  },
  "onboarding": {
    "mode": "manual"
  }
}
