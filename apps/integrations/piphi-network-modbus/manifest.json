{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-modbus",
  "name": "Modbus",
  "version": "0.3.1",
  "description": "Monitor and safely control profile-declared Modbus TCP and RTU points.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "protocol-bridge",
    "domain": "bridge",
    "preset_summary": "Protocol bridge starter for translating an external local protocol."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-modbus:0.3.1",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-modbus:0.3.1",
        "ports": [
          {
            "container": 4222,
            "host": 4222
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_ENV": "production",
          "PIPHI_MODBUS_SIDECAR_URL": "http://piphi-modbus-rtu-sidecar:4212"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "requires": {
    "services": [
      {
        "id": "piphi-modbus-rtu-sidecar",
        "kind": "platform_service",
        "version_range": ">=0.2.1,<0.3.0",
        "recommended_version": "0.2.1",
        "required": true,
        "shared": true,
        "auto_install": true,
        "reason": "Owns authenticated serial access, RTU framing, bounded request arbitration, and read/write execution for profile-declared RTU points."
      }
    ]
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "transport",
      "register_address",
      "unit_id",
      "poll_interval_seconds",
      "response_timeout_seconds",
      "profile_id",
      "profile_version",
      "profile_provenance",
      "points"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host"
    ]
  },
  "identity": {
    "fields": [
      "host"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "holding_register_value": {"kind": "sensor", "value_kind": "numeric"},
    "point_value": {"kind": "sensor", "value_kind": "numeric_or_boolean"},
    "refresh": {
      "kind": "action"
    },
    "set_value": {"kind": "action"}
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 12000
    },
    "set_value": {
      "description": "Set a profile-declared writable point within its bounds.",
      "timeout_ms": 30000
    }
  },
  "entities": [
    {
      "id": "demo-device",
      "name": "Demo Device",
      "device_id": "demo-device",
      "entity_type": "modbus_device",
      "capabilities": [
        "connected",
        "holding_register_value",
        "point_value",
        "set_value",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        },
        {"id": "set_value", "label": "Set value", "kind": "action"}
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {"registry_id": "io.piphi.modbus-register", "version_range": ">=0.1,<1", "auto_install": true}
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Modbus",
    "summary": "Profile-driven Modbus TCP and RTU monitoring with constrained controls.",
    "category": "other",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-modbus/issues",
      "security_contact": "support@piphi.io"
    },
    "access_declared": true,
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Discovers or communicates with supported services and devices on the homeowner's local network.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Multi-vendor",
        "model": "Local Modbus TCP or RTU device with reviewed point profiles"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-modbus",
    "support_url": "https://github.com/PiPhi-io/piphi-network-modbus/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-modbus/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "Modbus TCP server",
      "Modbus RTU device"
    ],
    "protocols": [
      "Modbus TCP",
      "Modbus RTU"
    ],
    "discovery_methods": [
      "manual"
    ],
    "connectivity": "local",
    "offline_support": "none"
  },
  "onboarding": {
    "mode": "manual"
  }
}
