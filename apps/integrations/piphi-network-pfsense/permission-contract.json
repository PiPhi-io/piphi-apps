  "actions": {
    "diagnostic_ping": [
      {"method": "POST", "path": "/api/v2/diagnostics/ping", "privilege": "api-v2-diagnostics-ping-post"}
    ],
    "restart_service": [
      {"method": "GET", "path": "/api/v2/status/services", "privilege": "api-v2-status-services-get"},
      {"method": "POST", "path": "/api/v2/status/service", "privilege": "api-v2-status-service-post"}
    ],
    "start_service": [
      {"method": "GET", "path": "/api/v2/status/services", "privilege": "api-v2-status-services-get"},
      {"method": "POST", "path": "/api/v2/status/service", "privilege": "api-v2-status-service-post"}
    ],
    "wake_on_lan": [
      {"method": "POST", "path": "/api/v2/services/wake_on_lan/send", "privilege": "api-v2-services-wake-on-lan-send-post"}
    ]
  },
  "denial_matrix": {
    "every_endpoint_and_action": [
      {"status": 401, "reason": "authentication_failed", "retryable": false, "remediation": "reauthenticate"},
      {"status": 403, "reason": "permission_denied", "retryable": false, "remediation": "reconfigure_permissions"},
      {"status": 404, "reason": "endpoint_or_version_unsupported", "retryable": false, "remediation": "reconfigure_api_version"},
      {"status": 429, "reason": "rate_limited", "retryable": true, "remediation": "retry", "honor_retry_after": true},
      {"status": 503, "reason": "server_error", "retryable": true, "remediation": "retry"}
    ]
  },
  "service_control": {
    "allowed_low_risk": ["collectd", "node_exporter", "telegraf"],
    "policy": "all critical and unclassified services are denied during configuration and command dispatch"
  },
  "forbidden": ["page-all", "firewall rule mutation", "route mutation", "user mutation", "VPN secret mutation", "arbitrary API path", "shell execution"]
