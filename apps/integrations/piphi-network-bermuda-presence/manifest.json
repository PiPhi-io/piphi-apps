{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-bermuda-presence",
  "name": "Bermuda presence",
  "version": "0.2.1",
  "description": "Turn supported BLE advertisements into room-level presence observations.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "sensor-device",
    "domain": "sensor",
    "preset_summary": "Local device starter with polling cadence and device diagnostics hooks."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-bermuda-presence:0.2.1",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-bermuda-presence:0.2.1",
        "ports": [
          {
            "container": 4206,
            "host": 4206
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "manual"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "gateway_url",
      "consumer_id",
      "selected_device_handles",
      "receivers",
      "alias",
      "poll_interval_seconds",
      "consider_home_seconds",
      "stale_seconds",
      "reference_power_dbm",
      "attenuation_factor",
      "smoothing_samples",
      "area_switch_margin_m",
      "area_switch_samples"
    ],
    "secret_fields": [
      "api_token"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "consumer_id"
    ]
  },
  "identity": {
    "fields": [
      "consumer_id"
    ]
  },
  "capabilities": {
    "presence": {
      "kind": "sensor",
      "unit": "enum"
    },
    "area_id": {"kind": "sensor", "unit": "string"},
    "area_name": {"kind": "sensor", "unit": "string"},
    "estimated_distance_m": {"kind": "sensor", "unit": "m"},
    "distance_raw_m": {"kind": "sensor", "unit": "m"},
    "freshness_seconds": {"kind": "sensor", "unit": "s"},
    "coverage_degraded": {"kind": "sensor", "unit": "bool"},
    "topology_revision": {"kind": "sensor", "unit": "count"},
    "area_switch_reason": {"kind": "sensor", "unit": "string"},
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 5000
    }
  },
  "entities": [
    {
      "id": "selected-device-template",
      "name": "Selected BLE device",
      "device_id": "selected-device-template",
      "entity_type": "presence_sensor",
      "capabilities": [
        "presence",
        "area_id",
        "area_name",
        "estimated_distance_m",
        "distance_raw_m",
        "freshness_seconds",
        "coverage_degraded",
        "topology_revision",
        "area_switch_reason",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
            "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.bermuda-presence-status",
        "version_range": ">=0.2,<1",
        "auto_install": true
      }
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Bermuda presence",
    "summary": "Turn supported BLE advertisements into room-level presence observations.",
    "category": "sensors",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-bermuda-presence/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "device_access",
        "label": "Bluetooth observation access",
        "reason": "Consumes only explicitly selected opaque handles from the authenticated shared BLE gateway.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Multi-vendor",
        "model": "Supported BLE beacons and personal devices"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-bermuda-presence",
    "support_url": "https://github.com/PiPhi-io/piphi-network-bermuda-presence/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-bermuda-presence/releases",
    "quality_tier": "bronze",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "presence sensor",
      "BLE beacon"
    ],
    "protocols": [
      "Bluetooth Low Energy"
    ],
    "discovery_methods": [
      "Manual gateway selection"
    ],
    "connectivity": "local",
    "offline_support": "degraded"
  },
  "onboarding": {
    "mode": "manual"
  }
}
