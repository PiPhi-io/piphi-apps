{
  "schema_version": "1",
  "identity": {
    "publisher_id": "io.piphi",
    "package_id": "bermuda-presence-status",
    "version": "0.2.1"
  },
  "name": "Bermuda Presence Coverage",
  "description": "A compact view of degraded BLE receiver coverage for selected devices.",
  "origin": "integration",
  "owning_integration_id": "piphi-network-bermuda-presence",
  "sdk_version_range": ">=0.6.1,<0.7",
  "requires_integrations": [
    {
      "integration_id": "piphi-network-bermuda-presence",
      "version_range": ">=0.1,<1",
      "optional": false
    }
  ],
  "recommended_for_integrations": [
    "piphi-network-bermuda-presence"
  ],
  "widgets": [
    {
      "id": "coverage-status",
      "name": "Bermuda Presence Coverage",
      "description": "Shows whether receiver coverage used for presence is degraded.",
      "runtime": "declarative",
      "presentation": {
        "contract_version": "1",
        "shell": "core",
        "content_surface": "transparent",
        "typography": "core",
        "appearance_controls": [
          "icon",
          "title",
          "surface",
          "opacity",
          "radius",
          "shadow"
        ]
      },
      "interaction_targets": [
        {
          "id": "card",
          "label": "Bermuda presence runtime",
          "kind": "card",
          "allowed_actions": [
            "more-info",
            "popout",
            "refresh"
          ],
          "default_action": "more-info"
        },
        {
          "id": "coverage",
          "label": "Coverage status",
          "kind": "binding",
          "binding_slot_id": "coverage_degraded",
          "allowed_actions": [
            "more-info",
            "history",
            "popout"
          ],
          "default_action": "more-info"
        }
      ],
      "binding_slots": [
        {
          "id": "coverage_degraded",
          "label": "Coverage degraded",
          "required": true,
          "binding_modes": [
            "read"
          ],
          "value_kinds": [
            "boolean"
          ],
          "capability_requirements": [
            "coverage_degraded"
          ],
          "compatible_integration_ids": [
            "piphi-network-bermuda-presence"
          ],
          "data_delivery": {
            "mode": "stream_preferred",
            "stale_after_seconds": 120
          }
        }
      ],
      "recipe": {
        "schema_version": "1",
        "layout": "grid",
        "columns": 1,
        "items": [
          {
            "type": "status",
            "slot_id": "coverage_degraded",
            "label": "BLE coverage",
            "true_label": "Degraded",
            "false_label": "Healthy",
            "domain": "diagnostic",
            "action": {
              "type": "details",
              "label": "View coverage details"
            }
          }
        ]
      },
      "certification": {
        "schema_version": "1",
        "verified_gates": ["runtime", "persistence", "binding", "states", "responsive", "themes", "accessibility", "save-reload", "performance"],
        "evidence": {
          "runtime": ["core-profile:declarative-v2/runtime"],
          "persistence": ["core-profile:declarative-v2/persistence"],
          "binding": ["core-profile:declarative-v2/binding"],
          "states": ["core-profile:declarative-v2/states"],
          "responsive": ["core-profile:declarative-v2/responsive"],
          "themes": ["core-profile:declarative-v2/themes"],
          "accessibility": ["core-profile:declarative-v2/accessibility"],
          "save-reload": ["core-profile:declarative-v2/save-reload"],
          "performance": ["core-profile:declarative-v2/performance"]
        }
      },
      "default_column_span": 3,
      "default_row_span": 2
    }
  ]
}
