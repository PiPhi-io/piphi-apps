{
  "devices": [
    {
      "id": "steam_account",
      "name": "Steam account",
      "description": "A Steam player account observed through the official Web API.",
      "deviceClass": "gaming_account",
      "entityType": "account",
      "capabilities": [
        "connected",
        "available",
        "stale",
        "reauth_required",
        "last_success_at",
        "consecutive_failures",
        "is_online",
        "is_in_game",
        "persona_state",
        "current_game_name",
        "owned_game_count",
        "recent_game_count",
        "total_playtime_minutes",
        "recent_playtime_minutes",
        "refresh"
      ],
      "conditions": [
        {
          "id": "is_online",
          "label": "Player is online",
          "type": "boolean",
          "capability": "is_online",
          "runtime": {
            "source": "state",
            "field": "is_online",
            "operator": "eq"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "only_if"
          }
        },
        {
          "id": "is_in_game",
          "label": "Player is in a game",
          "type": "boolean",
          "capability": "is_in_game",
          "runtime": {
            "source": "state",
            "field": "is_in_game",
            "operator": "eq"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "block"
          },
          "ui": {
            "group": "only_if"
          }
        }
      ],
      "actions": [
        {
          "id": "refresh",
          "label": "Refresh Steam activity",
          "capability": "refresh",
          "runtime": {
            "command": "refresh"
          },
          "targeting": {
            "fanoutSafe": true,
            "scopes": [
              "config",
              "configs",
              "selection"
            ],
            "supportsMultiTarget": true
          },
          "failure": {
            "strategy": "retry_then_continue",
            "retry": {
              "maxAttempts": 1,
              "delaySeconds": 2,
              "backoff": "fixed"
            },
            "timeoutSeconds": 30,
            "continueOnPartialFailure": true,
            "idempotent": true
          },
          "ui": {
            "group": "do_this"
          },
          "safety": {
            "riskLevel": "low"
          }
        }
      ],
      "freshness": {
        "maxAgeSeconds": 600,
        "staleDataMode": "block"
      },
      "triggers": [
        {
          "id": "steam_game_started",
          "label": "Game started",
          "description": "Game started.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "steam.game.started",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "allow"
          },
          "ui": {
            "group": "when"
          }
        },
        {
          "id": "steam_game_stopped",
          "label": "Game stopped",
          "description": "Game stopped.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "steam.game.stopped",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "allow"
          },
          "ui": {
            "group": "when"
          }
        },
        {
          "id": "steam_game_changed",
          "label": "Game changed",
          "description": "Game changed.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "steam.game.changed",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "allow"
          },
          "ui": {
            "group": "when"
          }
        },
        {
          "id": "steam_persona_changed",
          "label": "Persona changed",
          "description": "Persona changed.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "steam.persona.changed",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "allow"
          },
          "ui": {
            "group": "when"
          }
        },
        {
          "id": "steam_account_unavailable",
          "label": "Steam unavailable",
          "description": "Steam unavailable.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "steam.account.unavailable",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "allow"
          },
          "ui": {
            "group": "when"
          }
        },
        {
          "id": "steam_account_recovered",
          "label": "Steam recovered",
          "description": "Steam recovered.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "steam.account.recovered",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "allow"
          },
          "ui": {
            "group": "when"
          }
        },
        {
          "id": "steam_account_reauth_required",
          "label": "Steam reauthentication required",
          "description": "Steam reauthentication required.",
          "capability": "telemetry.state",
          "runtime": {
            "event": "steam.account.reauth_required",
            "source": "integration"
          },
          "freshness": {
            "maxAgeSeconds": 600,
            "staleDataMode": "allow"
          },
          "ui": {
            "group": "when"
          }
        }
      ]
    }
  ]
}
