{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-bacnet",
  "name": "BACnet",
  "version": "0.1.1",
  "description": "Read-only BACnet/IP monitoring for an explicitly configured Kaiterra SenseEdge Mini.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "protocol-bridge",
    "domain": "bridge",
    "preset_summary": "Protocol bridge starter for translating an external local protocol."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "ghcr.io/piphi-io/piphi-network-bacnet:0.1.1",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "ghcr.io/piphi-io/piphi-network-bacnet:0.1.1",
        "network_mode": "host",
        "privileged": false,
        "read_only": true,
        "cap_drop": ["ALL"],
        "security_opt": ["no-new-privileges:true"],
        "ports": [
          {
            "container": 4224,
            "host": 4224
          }
        ],
        "environment": {
          "LOG_LEVEL": "info",
          "PIPHI_AUTOMATION_LEDGER_PATH": "/app/data/automation-actions.sqlite3"
        },
        "volumes": [
          {"host": "/var/lib/piphi/bacnet", "container": "/app/data", "mode": "rw"}
        ],
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "manual"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "port",
      "device_instance",
      "local_address",
      "local_device_instance",
      "profile",
      "alias",
      "poll_interval_seconds"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host",
      "device_instance"
    ]
  },
  "identity": {
    "fields": [
      "host",
      "device_instance"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "pm2_5_ug_m3": {"kind": "sensor", "unit": "µg/m³"},
    "pm10_ug_m3": {"kind": "sensor", "unit": "µg/m³"},
    "tvoc_ppb": {"kind": "sensor", "unit": "ppb"},
    "tvoc_ug_m3": {"kind": "sensor", "unit": "µg/m³"},
    "temperature_c": {"kind": "sensor", "unit": "°C"},
    "humidity_percent": {"kind": "sensor", "unit": "%"},
    "co2_ppm": {"kind": "sensor", "unit": "ppm"},
    "km20x_module_8_lifespan_percent": {"kind": "sensor", "unit": "%"},
    "km20x_module_9_lifespan_percent": {"kind": "sensor", "unit": "%"},
    "ozone_ppb": {"kind": "sensor", "unit": "ppb"},
    "differential_pressure_pa": {"kind": "sensor", "unit": "Pa"},
    "flow_speed_pressure_pa": {"kind": "sensor", "unit": "Pa"},
    "in_duct_module_lifespan_percent": {"kind": "sensor", "unit": "%"},
    "no2_ppb": {"kind": "sensor", "unit": "ppb"},
    "co_ppm": {"kind": "sensor", "unit": "ppm"},
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Perform an immediate read-only refresh of allowlisted BACnet properties.",
      "timeout_ms": 30000
    }
  },
  "entities": [
    {
      "id": "kaiterra-sensedge-mini",
      "name": "Kaiterra SenseEdge Mini",
      "device_id": "kaiterra-sensedge-mini",
      "entity_type": "air_quality_sensor",
      "capabilities": [
        "connected",
        "pm2_5_ug_m3",
        "pm10_ug_m3",
        "tvoc_ppb",
        "tvoc_ug_m3",
        "temperature_c",
        "humidity_percent",
        "co2_ppm",
        "km20x_module_8_lifespan_percent",
        "km20x_module_9_lifespan_percent",
        "ozone_ppb",
        "differential_pressure_pa",
        "flow_speed_pressure_pa",
        "in_duct_module_lifespan_percent",
        "no2_ppb",
        "co_ppm",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh readings",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "ui": {"experience_packages": []},
  "marketplace": {
    "metadata_version": 2,
    "display_name": "BACnet",
    "summary": "Read-only indoor-air-quality telemetry from a Kaiterra SenseEdge Mini over BACnet/IP.",
    "category": "other",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-bacnet/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Communicates with one explicitly configured SenseEdge Mini on the local network.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Kaiterra",
        "model": "SenseEdge Mini SE-200 and SE-200P with BACnet firmware 2.1.1 or later"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-bacnet",
    "support_url": "https://github.com/PiPhi-io/piphi-network-bacnet/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-bacnet/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "air quality sensor"
    ],
    "protocols": [
      "BACnet/IP"
    ],
    "discovery_methods": [
      "manual explicit target"
    ],
    "connectivity": "local",
    "offline_support": "full"
  },
  "onboarding": {
    "mode": "manual"
  }
}
