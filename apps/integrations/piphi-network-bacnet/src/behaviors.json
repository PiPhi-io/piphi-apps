{
  "behaviorSchemaVersion": "integration.behaviors.v2",
  "templates": [],
  "devices": [
    {
      "id": "kaiterra_sensedge_mini",
      "name": "Kaiterra SenseEdge Mini",
      "description": "Read-only BACnet/IP indoor-air-quality profile.",
      "deviceClass": "air_quality_sensor",
      "entityType": "air_quality_sensor",
      "capabilities": [
        "connected",
        "pm2_5_ug_m3",
        "pm10_ug_m3",
        "tvoc_ppb",
        "tvoc_ug_m3",
        "temperature_c",
        "humidity_percent",
        "co2_ppm",
        "km20x_module_8_lifespan_percent",
        "km20x_module_9_lifespan_percent",
        "ozone_ppb",
        "differential_pressure_pa",
        "flow_speed_pressure_pa",
        "in_duct_module_lifespan_percent",
        "no2_ppb",
        "co_ppm",
        "refresh"
      ],
      "targeting": {
        "scopes": ["config", "selection"],
        "fanout": {
          "supported": false,
          "defaultMode": "selection",
          "allowedModes": ["config", "selection"]
        }
      },
      "freshness": {"maxAgeSeconds": 180, "staleDataMode": "block"},
      "ui": {"icon": "gauge", "category": "air_quality"},
      "triggers": [
        {
          "id": "config_applied",
          "label": "Configuration applied",
          "description": "Start after this read-only profile is configured.",
          "capability": "runtime.configuration",
          "runtime": {"event": "runtime.config.applied", "source": "integration"},
          "freshness": {"maxAgeSeconds": 180, "staleDataMode": "block"},
          "ui": {"group": "when"}
        }
      ],
      "intents": [
        {"id": "monitor_air_quality", "label": "Monitor indoor air quality", "description": "Use negotiated SenseEdge readings in automations."}
      ],
      "conditions": [
        {
          "id": "state_matches",
          "label": "Reading matches",
          "description": "Compare an emitted read-only state field.",
          "type": "number",
          "capability": "telemetry.state",
          "operators": ["eq", "neq", "gt", "gte", "lt", "lte"],
          "runtime": {"source": "state", "field": "metrics", "operator": "eq"},
          "freshness": {"maxAgeSeconds": 180, "staleDataMode": "block"},
          "ui": {"group": "only_if"},
          "params": [
            {"name": "field", "label": "Metric", "type": "text", "required": true},
            {"name": "value", "label": "Value", "type": "number", "required": true}
          ]
        }
      ],
      "actions": [
        {
          "id": "refresh",
          "label": "Refresh readings",
          "description": "Immediately re-read the bounded allowlist of BACnet properties.",
          "capability": "device.refresh",
          "capabilityRequirements": ["device.refresh"],
          "runtime": {"command": "refresh", "endpoint": "/command", "method": "POST", "timeoutSeconds": 30},
          "safety": {"riskLevel": "low", "requiresConfirmation": false, "liveRunAllowed": true},
          "targeting": {"fanoutSafe": false, "supportsMultiTarget": false, "scopes": ["config", "selection"]},
          "failure": {"strategy": "fail_fast", "retry": {"maxAttempts": 1, "delaySeconds": 1, "backoff": "fixed"}, "timeoutSeconds": 30, "continueOnPartialFailure": false, "idempotent": true},
          "ui": {"group": "do_this"}
        }
      ],
      "stop": [],
      "manualOverride": []
    }
  ]
}
