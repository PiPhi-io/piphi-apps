{
  "version": 2,
  "upstream": {
    "project": "MikroTik RouterOS",
    "documentation": "https://help.mikrotik.com/docs/spaces/ROS/pages/47579162/REST+API"
  },
  "custom_group": {
    "name": "piphi-rest-read",
    "exact_policies": ["read", "api", "rest-api"],
    "source_address_required": true,
    "example": "/user/group/add name=piphi-rest-read policy=read,api,rest-api"
  },
  "profiles": {
    "baseline-monitoring": [
      {"method": "GET", "path": "/rest/system/resource", "policies": ["read", "api", "rest-api"]},
      {"method": "GET", "path": "/rest/system/license", "policies": ["read", "api", "rest-api"]}
    ]
  },
  "actions": {},
  "denial_matrix": {
    "every_endpoint": [
      {"status": 401, "reason": "authentication_failed", "retryable": false, "remediation": "reauthenticate"},
      {"status": 403, "reason": "permission_denied", "retryable": false, "remediation": "reconfigure_permissions"},
      {"status": 404, "reason": "routeros_rest_unsupported", "retryable": false, "remediation": "reconfigure_permissions"},
      {"status": 429, "reason": "rate_limited", "retryable": true, "remediation": "retry", "honor_retry_after": true},
      {"status": 503, "reason": "routeros_server_error", "retryable": true, "remediation": "retry"}
    ]
  },
  "forbidden_policies": ["write", "policy", "test", "sensitive", "reboot", "ftp", "sniff", "password", "local", "telnet", "ssh", "web", "winbox", "romon"],
  "forbidden": ["firewall mutation", "route mutation", "user mutation", "VPN mutation", "arbitrary REST path", "console execution"]
}
