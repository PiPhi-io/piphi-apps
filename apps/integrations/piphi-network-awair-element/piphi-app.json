{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "piphi-network-awair-element",
  "source": {
    "imported_from": "https://github.com/KelvinSan/piphi-network-awair-element"
  },
  "languages": [
    "python"
  ],
  "toolchains": {
    "python": "3.12"
  },
  "ci": {
    "enforcement": "full",
    "commands": [
      "pdm install --check -G dev",
      "pdm run ruff check src tests",
      "pdm run mypy src",
      "pdm run pytest -q",
      "pdm run bandit -q -r src",
      "pdm run pip-audit --ignore-vuln PYSEC-2026-1845",
      "pdm build --no-sdist"
    ],
    "build_container": true
  },
  "packages": [
    {
      "id": "awair-element-local-api",
      "type": "integration",
      "version": "0.1.15",
      "manifest": "src/manifest.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "oci",
        "context": ".",
        "dockerfile": "Dockerfile",
        "platforms": [
          "linux/amd64",
          "linux/arm64"
        ]
      },
      "publishing": {
        "mode": "piphi_managed",
        "environment": "release-ghcr-io",
        "primary": {
          "registry": "ghcr.io",
          "repository": "piphi-io/awair-element"
        },
        "mirrors": []
      }
    }
  ]
}
