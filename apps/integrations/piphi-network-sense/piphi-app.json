{
  "schema_version": 1,
  "$schema": "../../../contracts/piphi-app.schema.json",
  "slug": "piphi-network-sense",
  "source": {
    "imported_from": "https://github.com/PiPhi-io/piphi-network-sense"
  },
  "languages": [
    "python",
    "node"
  ],
  "toolchains": {
    "python": "3.12",
    "node": "22"
  },
  "ci": {
    "enforcement": "full",
    "commands": [
      "pdm install --check",
      "pdm run pytest",
      "pdm run python scripts/validate.py",
      "pdm run python scripts/check_release.py v0.2.1",
      "for widget in sense-energy-flow sense-device-breakdown; do (cd widgets/$widget && npm ci --ignore-scripts && npm run build && npm test && npm run conformance); done"
    ],
    "build_container": true
  },
  "packages": [
    {
      "id": "piphi-network-sense",
      "type": "integration",
      "version": "0.2.1",
      "manifest": "manifest.json",
      "release": {
        "tag": "apps/{package_id}/v{version}",
        "commands": []
      },
      "artifact": {
        "kind": "oci",
        "context": ".",
        "dockerfile": "Dockerfile",
        "platforms": [
          "linux/amd64",
          "linux/arm64"
        ]
      },
      "publishing": {
        "mode": "piphi_managed",
        "environment": "release-ghcr-io",
        "primary": {
          "registry": "ghcr.io",
          "repository": "piphi-io/piphi-network-sense"
        },
        "mirrors": []
      }
    }
  ]
}
